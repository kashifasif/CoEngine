    private static string GetInitials(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "SP";
        var parts = text.Trim().Split(new[] { ' ', '-', '_' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }

        return text.Length >= 2 ? text.Substring(0, 2).ToUpper() : text.ToUpper();
    }

    private static string GetTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes} min ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours} hr ago";
        if (span.TotalDays < 30) return $"{(int)span.TotalDays} days ago";
        return dt.ToString("MMM dd");
    }

    private bool isInsideProject
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
            if (string.IsNullOrWhiteSpace(relative) || relative == "dashboard" || relative == "login" || relative.StartsWith("auth"))
            {
                return false;
            }

            return !string.IsNullOrWhiteSpace(selectedProjectName);
        }
    }

