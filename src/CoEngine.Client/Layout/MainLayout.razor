    private async Task ToggleNotificationsPopover()
    {
        showNotificationsPopover = !showNotificationsPopover;
        if (showNotificationsPopover)
        {
            if (!displayedNotifications.Any())
            {
                await LoadInitialNotifications();
            }

            await Task.Yield();
            notifDotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("notificationScrollManager.initInfiniteScroll", "notificationScrollContainer", notifDotNetRef);
        }
    }

    private async Task LoadInitialNotifications()
    {
        isLoadingInitialNotifications = true;
        StateHasChanged();
        try
        {
            var list = await ApiClient.GetNotificationsAsync(skip: 0, take: 5);
            displayedNotifications = list;
            hasMoreNotifications = list.Count >= 5;
            hasUnreadNotifications = list.Any();
        }
        catch
        {
        }
        finally
        {
            isLoadingInitialNotifications = false;
            StateHasChanged();
        }
    }

    private async Task LoadNotifications()
    {
        await LoadInitialNotifications();
    }

    [JSInvokable]
    public async Task OnLoadOlderNotificationsAsync()
    {
        if (isLoadingMoreNotifications || !hasMoreNotifications) return;
        isLoadingMoreNotifications = true;
        StateHasChanged();

        await Task.Delay(250); // brief smooth animation for loader

        try
        {
            int currentCount = displayedNotifications.Count;
            var older = await ApiClient.GetNotificationsAsync(skip: currentCount, take: 5);
            if (older.Any())
            {
                displayedNotifications.AddRange(older);
                hasMoreNotifications = older.Count >= 5;
            }
            else
            {
                hasMoreNotifications = false;
            }
        }
        catch
        {
        }
        finally
        {
            isLoadingMoreNotifications = false;
            StateHasChanged();
        }
    }

