@inherits LayoutComponentBase
@implements IDisposable
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="min-h-screen flex flex-col bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors">

@if (currentUser != null && currentUser.IsAuthenticated)
{
    <!-- Top Navigation Bar -->
    <header class="fixed top-0 inset-x-0 h-14 z-30 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md border-b border-zinc-200/80 dark:border-zinc-800/80 px-4 sm:px-6 flex items-center justify-between transition-colors">
        <!-- Left: Branding, Project Switcher, and Nav Links -->
        <div class="flex items-center gap-4 lg:gap-6 min-w-0">
            <!-- Branding -->
            <a class="flex items-center gap-2.5 text-zinc-900 dark:text-white no-underline font-semibold tracking-tight text-base shrink-0" href="dashboard">
                <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-xs">
                    <span class="material-symbols-outlined text-[18px]">layers</span>
                </div>
                <span class="hidden sm:inline">CoEngine</span>
            </a>

            <!-- Vertical Separator -->
            <div class="h-5 w-px bg-zinc-200 dark:bg-zinc-800 shrink-0"></div>

            <!-- Project Selector Dropdown -->
            @if (availableProjects.Any())
            {
                <div class="relative">
                    <button type="button" class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200/80 dark:hover:bg-zinc-700/80 text-xs font-semibold text-zinc-900 dark:text-zinc-100 transition-colors cursor-pointer border border-zinc-200/80 dark:border-zinc-700/80" @onclick="() => showProjectSelector = !showProjectSelector" title="Switch Project Space">
                        <div class="w-4 h-4 rounded bg-indigo-600 text-white font-mono text-[9px] font-bold flex items-center justify-center shrink-0">
                            @(selectedProjectName.Length >= 2 ? selectedProjectName.Substring(0, 2).ToUpper() : "PR")
                        </div>
                        <span class="truncate max-w-[110px] sm:max-w-[160px] md:max-w-[200px]">@selectedProjectName</span>
                        <span class="material-symbols-outlined text-[16px] text-zinc-400">expand_more</span>
                    </button>

                    @if (showProjectSelector)
                    {
                        <div class="fixed inset-0 z-40" @onclick="() => showProjectSelector = false"></div>
                        <div class="absolute top-full left-0 mt-2 w-64 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-xl p-1.5 z-50 animate-in fade-in zoom-in-95 duration-100 flex flex-col gap-1">
                            <div class="px-2.5 py-1.5 text-[10px] uppercase font-bold text-zinc-400 dark:text-zinc-500 tracking-wider">
                                Active Project
                            </div>
                            @foreach (var proj in availableProjects)
                            {
                                bool isCur = proj.Name == selectedProjectName;
                                <button type="button" class="w-full text-left px-2.5 py-2 rounded-lg text-xs font-medium flex items-center justify-between transition-colors cursor-pointer @(isCur ? "bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-semibold" : "text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800")"
                                        @onclick="() => SelectProjectSpace(proj)">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <div class="w-5 h-5 rounded bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-mono text-[10px] flex items-center justify-center shrink-0">
                                            @(proj.Name.Length >= 2 ? proj.Name.Substring(0, 2).ToUpper() : "PR")
                                        </div>
                                        <span class="truncate">@proj.Name</span>
                                    </div>
                                    @if (isCur)
                                    {
                                        <span class="material-symbols-outlined text-[16px] text-indigo-600 dark:text-indigo-400">check</span>
                                    }
                                </button>
                            }
                            <div class="border-t border-zinc-100 dark:border-zinc-800 my-0.5"></div>
                            <a href="dashboard" class="px-2.5 py-2 text-xs font-medium text-indigo-600 dark:text-indigo-400 hover:bg-indigo-50 dark:hover:bg-indigo-950/40 rounded-lg flex items-center gap-2 no-underline cursor-pointer" @onclick="() => showProjectSelector = false">
                                <span class="material-symbols-outlined text-[16px]">grid_view</span>
                                <span>All Projects Dashboard</span>
                            </a>
                        </div>
                    }
                </div>
            }

            <!-- Horizontal Top Navigation Links -->
            <nav class="hidden md:flex items-center gap-1">
                <NavLink class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="dashboard" Match="NavLinkMatch.All">
                    <span class="material-symbols-outlined text-[17px]">grid_view</span>
                    <span>Projects</span>
                </NavLink>

                <NavLink class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="specs">
                    <span class="material-symbols-outlined text-[17px]">description</span>
                    <span>Specifications</span>
                </NavLink>

                <NavLink class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="ai-workspace">
                    <span class="material-symbols-outlined text-[17px]">auto_awesome</span>
                    <span>AI Workspace</span>
                </NavLink>

                <NavLink class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="published-specs-qa">
                    <span class="material-symbols-outlined text-[17px]">chat</span>
                    <span>Dev/QA Copilot</span>
                </NavLink>

                <NavLink class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800/80 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="versions">
                    <span class="material-symbols-outlined text-[17px]">history</span>
                    <span>Versions</span>
                </NavLink>
            </nav>
        </div>

        <!-- Right Side Header Actions -->
        <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">
            <!-- Notifications Popover -->
            <div class="relative">
                <button class="relative p-2 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors cursor-pointer" @onclick="ToggleNotificationsPopover" title="Notifications">
                    <span class="material-symbols-outlined text-[20px]">notifications</span>
                    @if (hasUnreadNotifications || displayedNotifications.Any())
                    {
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-indigo-600 rounded-full"></span>
                    }
                </button>

                @if (showNotificationsPopover)
                {
                    <!-- Background Click Catcher -->
                    <div class="fixed inset-0 z-40" @onclick="() => showNotificationsPopover = false"></div>

                    <!-- Notification Card matching Tailwind CSS Design -->
                    <div class="absolute top-full right-0 mt-2 w-80 sm:w-96 bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-2xl z-50 animate-in fade-in zoom-in-95 duration-100 flex flex-col max-h-[30rem] overflow-hidden">
                        <!-- Header -->
                        <div class="px-5 py-4 flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800/80">
                            <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100 tracking-tight m-0">Notification</h3>
                            <button class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer p-1 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors" @onclick="() => showNotificationsPopover = false">
                                <span class="material-symbols-outlined text-[18px]">close</span>
                            </button>
                        </div>

                        <!-- Scrollable List with Lazy Loading -->
                        <div id="notificationScrollContainer" class="overflow-y-auto px-3.5 py-3 flex-1 flex flex-col gap-1.5 divide-y divide-zinc-100 dark:divide-zinc-800/50">
                            @if (isLoadingInitialNotifications)
                            {
                                <div class="py-8 flex flex-col items-center justify-center gap-2 text-xs text-zinc-400 font-mono">
                                    <div class="animate-spin w-5 h-5 border-2 border-indigo-600 border-t-transparent rounded-full"></div>
                                    <span>Loading notifications...</span>
                                </div>
                            }
                            else if (!displayedNotifications.Any())
                            {
                                <div class="py-10 text-center flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500">
                                    <span class="material-symbols-outlined text-3xl mb-1 text-zinc-300 dark:text-zinc-600">notifications_off</span>
                                    <span class="text-xs font-mono">No notifications found</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var notif in displayedNotifications)
                                {
                                    <div class="pt-2 first:pt-0">
                                        <div class="flex items-start gap-3 group cursor-pointer hover:bg-zinc-50 dark:hover:bg-zinc-800/50 p-2.5 rounded-xl transition-colors" @onclick="() => NavigateToNotificationSpec(notif)">
                                            <!-- Avatar with Status Indicator Dot -->
                                            <div class="relative shrink-0 mt-0.5">
                                                @if (!string.IsNullOrWhiteSpace(notif.AuthorAvatarUrl))
                                                {
                                                    <img src="@notif.AuthorAvatarUrl" class="w-10 h-10 rounded-full object-cover border border-zinc-200 dark:border-zinc-700" alt="Avatar"/>
                                                }
                                                else
                                                {
                                                    <div class="w-10 h-10 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-semibold text-xs flex items-center justify-center border border-indigo-200 dark:border-indigo-800 shadow-2xs font-mono">
                                                        @(GetInitials(notif.AuthorDisplayName ?? notif.AuthorUsername ?? notif.ProjectName))
                                                    </div>
                                                }
                                                <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-white dark:border-zinc-900 rounded-full"></span>
                                            </div>

                                            <!-- Content Text -->
                                            <div class="flex-1 min-w-0">
                                                <p class="text-xs text-zinc-700 dark:text-zinc-300 leading-snug m-0">
                                                    <strong class="font-bold text-zinc-900 dark:text-white">@(notif.AuthorDisplayName ?? notif.AuthorUsername ?? "Author")</strong>
                                                    <span class="text-zinc-600 dark:text-zinc-400"> @(notif.ActionType == "undone" ? "undone publication of" : (notif.ActionType == "restored" ? "restored" : "published")) </span>
                                                    <strong class="font-bold text-zinc-900 dark:text-white">@(notif.SpecTitle)</strong>
                                                </p>
                                                <div class="flex items-center gap-1.5 text-[11px] text-zinc-400 dark:text-zinc-500 mt-1 font-mono">
                                                    <span class="truncate max-w-[120px]">@notif.ProjectName</span>
                                                    <span>&bull;</span>
                                                    <span>@(GetTimeAgo(notif.CreatedAt))</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (isLoadingMoreNotifications)
                                {
                                    <div class="py-2.5 flex items-center justify-center gap-2 text-xs text-indigo-600 dark:text-indigo-400 font-mono">
                                        <div class="animate-spin w-4 h-4 border-2 border-indigo-600 border-t-transparent rounded-full"></div>
                                        <span>Loading more...</span>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Footer Button -->
                        <div class="p-3.5 border-t border-zinc-100 dark:border-zinc-800/80 bg-white dark:bg-zinc-900">
                            <button class="w-full py-2.5 px-4 rounded-xl border border-zinc-200 dark:border-zinc-700 text-xs font-semibold text-zinc-800 dark:text-zinc-200 hover:bg-zinc-50 dark:hover:bg-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-600 transition-colors shadow-2xs cursor-pointer text-center" @onclick="ViewAllNotifications">
                                View All Notification
                            </button>
                        </div>
                    </div>
                }
            </div>

            <!-- AI Total Tokens Indicator Pill (Header) -->
            <a href="dashboard" class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-indigo-50/70 hover:bg-indigo-100 dark:bg-indigo-950/40 dark:hover:bg-indigo-950/70 border border-indigo-200/80 dark:border-indigo-800/60 text-indigo-700 dark:text-indigo-300 transition-colors text-xs font-mono font-medium no-underline cursor-pointer" title="Total AI Tokens Used — Click to view Dashboard Analytics">
                <span class="material-symbols-outlined text-[16px] text-indigo-600 dark:text-indigo-400">bolt</span>
                <span>@(FormatTokenCount(aiUsageSummary?.TotalTokens ?? 0))</span>
                <span class="text-[10px] text-indigo-500/70 dark:text-indigo-400/70 font-sans">tokens</span>
            </a>

            <!-- Theme Toggle -->
            <button class="p-2 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors" @onclick="ToggleTheme" title="Toggle Light/Dark Theme">
                @if (currentTheme == "light")
                {
                    <span class="material-symbols-outlined text-[20px]">dark_mode</span>
                }
                else
                {
                    <span class="material-symbols-outlined text-[20px]">light_mode</span>
                }
            </button>

            <!-- User Dropdown -->
            <div class="relative ml-1 pl-3 border-l border-zinc-200 dark:border-zinc-800">
                <button class="flex items-center gap-2 focus:outline-none cursor-pointer" @onclick="ToggleUserMenu" title="@currentUser.DisplayName (@currentUser.Username)">
                    @if (!string.IsNullOrWhiteSpace(currentUser.AvatarUrl))
                    {
                        <img src="@currentUser.AvatarUrl" class="w-8 h-8 rounded-full border border-zinc-200 dark:border-zinc-700 object-cover" alt="Avatar"/>
                    }
                    else
                    {
                        <div class="w-8 h-8 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-mono font-medium text-xs flex items-center justify-center border border-indigo-200 dark:border-indigo-800">
                            @(currentUser.Username.Length >= 2 ? currentUser.Username.Substring(0, 2).ToUpper() : "GH")
                        </div>
                    }
                </button>

                @if (showUserMenu)
                {
                    <div class="absolute top-full right-0 mt-2 w-56 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-lg p-1.5 z-50 animate-in fade-in zoom-in-95 duration-100 flex flex-col gap-0.5">
                        <div class="px-3 py-2 border-b border-zinc-100 dark:border-zinc-800/80 mb-1">
                            <div class="font-medium text-sm text-zinc-900 dark:text-zinc-100 truncate">@currentUser.DisplayName</div>
                            <div class="text-xs text-zinc-400 dark:text-zinc-500 font-mono truncate">@currentUser.Username</div>
                        </div>

                        <a href="dashboard" class="w-full text-left px-3 py-2 text-xs font-medium text-zinc-700 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg flex items-center justify-between transition-colors no-underline cursor-pointer" @onclick="() => showUserMenu = false">
                            <div class="flex items-center gap-2">
                                <span class="material-symbols-outlined text-[16px] text-indigo-600 dark:text-indigo-400">bolt</span>
                                <span>AI Token Analytics</span>
                            </div>
                            <span class="badge badge-primary text-[10px] font-mono">@(FormatTokenCount(aiUsageSummary?.TotalTokens ?? 0))</span>
                        </a>

                        <button class="w-full text-left px-3 py-2 text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-lg flex items-center gap-2 transition-colors cursor-pointer" @onclick="LogoutUser">
                            <span class="material-symbols-outlined text-[16px]">logout</span>
                            <span>Sign Out</span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Mobile Sub-Navigation Bar for smaller viewports -->
    <div class="md:hidden fixed top-14 inset-x-0 h-11 bg-white/95 dark:bg-zinc-900/95 border-b border-zinc-200 dark:border-zinc-800 px-4 flex items-center gap-2 overflow-x-auto z-20 backdrop-blur-md">
        <NavLink class="px-2.5 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 rounded-md whitespace-nowrap [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="dashboard" Match="NavLinkMatch.All">
            Projects
        </NavLink>
        <NavLink class="px-2.5 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 rounded-md whitespace-nowrap [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="specs">
            Specs
        </NavLink>
        <NavLink class="px-2.5 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 rounded-md whitespace-nowrap [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="ai-workspace">
            AI Workspace
        </NavLink>
        <NavLink class="px-2.5 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 rounded-md whitespace-nowrap [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="published-specs-qa">
            Copilot
        </NavLink>
        <NavLink class="px-2.5 py-1 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 rounded-md whitespace-nowrap [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/60 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400 [&.active]:font-semibold" href="versions">
            Versions
        </NavLink>
    </div>
}

<div class="flex flex-1 @(currentUser != null && currentUser.IsAuthenticated ? "pt-14 md:pt-14" : "")">
    @if (currentUser != null && currentUser.IsAuthenticated)
    {
        <!-- Main Content Area: Spans 100% Full Width -->
        <main class="flex-1 w-full min-h-[calc(100vh-56px)] bg-zinc-50 dark:bg-zinc-950 p-4 sm:p-6 lg:p-8 transition-all">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="card p-4 border-rose-200 dark:border-rose-900/60 bg-rose-50 dark:bg-rose-950/30 text-rose-900 dark:text-rose-100 flex items-center justify-between mb-6">
                        <div class="flex items-center gap-3">
                            <span class="material-symbols-outlined text-rose-600 dark:text-rose-400 text-xl">error_outline</span>
                            <div>
                                <div class="font-medium text-xs">An unexpected error occurred.</div>
                                <div class="text-[11px] text-rose-600 dark:text-rose-400 font-mono">Please refresh the page to reload the state.</div>
                            </div>
                        </div>
                        <button class="btn-danger text-xs px-3 py-1.5" onclick="location.reload()">Reload</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    }
    else
    {
        <!-- Unauthenticated View -->
        <main class="flex-1 w-full min-h-screen bg-zinc-50 dark:bg-zinc-950 flex items-center justify-center p-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="ex">
                    <div class="card p-4 border-rose-200 dark:border-rose-900 bg-rose-50 text-rose-900">
                        <div class="font-medium text-sm">An error occurred.</div>
                        <button class="btn-danger text-xs mt-2" onclick="location.reload()">Reload</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    }
</div>

</div>

@code {
    private HealthCheckResponse? healthResponse;
    private string currentTheme = "dark";
    private string selectedProjectName = "Loan Approval Feature";
    private UserDto? currentUser;
    private bool showUserMenu = false;

    private bool showNotificationsPopover = false;
    private bool hasUnreadNotifications = false;
    private bool isLoadingInitialNotifications = false;
    private bool isLoadingMoreNotifications = false;
    private bool hasMoreNotifications = true;
    private List<NotificationDto> displayedNotifications = new();
    private DotNetObjectReference<MainLayout>? notifDotNetRef;

    private UserAiUsageSummaryDto? aiUsageSummary;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await LoadUserSession();
        EnforceAuthRedirect();

        if (currentUser != null && currentUser.IsAuthenticated)
        {
            await CheckHealth();
            await LoadNotifications();
            await LoadProjectSpace();
            await LoadAiUsage();
        }
    }

    protected override void OnParametersSet()
    {
        EnforceAuthRedirect();
    }

    private void EnforceAuthRedirect()
    {
        var relativeUri = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        if (currentUser == null || !currentUser.IsAuthenticated)
        {
            if (!string.IsNullOrWhiteSpace(relativeUri) && relativeUri != "login" && !relativeUri.StartsWith("auth/github/callback"))
            {
                Nav.NavigateTo("/");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                currentTheme = await JS.InvokeAsync<string>("themeManager.getTheme");
                StateHasChanged();
            }
            catch
            {
            }
        }
    }

    private async Task LoadUserSession()
    {
        try
        {
            currentUser = await ApiClient.GetCurrentUserAsync();
        }
        catch
        {
        }
    }

    private async Task InitiateGitHubLogin()
    {
        try
        {
            var authUrlDto = await ApiClient.GetGitHubAuthUrlAsync();

            if (authUrlDto != null && !string.IsNullOrWhiteSpace(authUrlDto.AuthUrl))
            {
                Nav.NavigateTo(authUrlDto.AuthUrl, forceLoad: true);
            }
        }
        catch
        {
        }
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task LogoutUser()
    {
        showUserMenu = false;
        try
        {
            await ApiClient.LogoutAsync();
        }
        catch
        {
        }

        currentUser = null;
        StateHasChanged();
        Nav.NavigateTo("/login");
    }

