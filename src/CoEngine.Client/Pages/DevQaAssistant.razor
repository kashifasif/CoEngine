@page "/published-specs-qa"
@page "/published-specs-qa/{ProjectId:guid}"
@page "/dev-qa-assistant"
@page "/dev-qa-assistant/{ProjectId:guid}"
@implements IDisposable
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="fixed inset-0 top-14 left-0 flex flex-col bg-zinc-50 dark:bg-zinc-950 overflow-hidden z-10">

    <!-- Header Toolbar (Fixed at Top) -->
    <header class="h-14 border-b border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md px-4 sm:px-6 flex items-center justify-between shrink-0 gap-4 shadow-2xs">
        <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center border border-indigo-200/60 dark:border-indigo-800/60 shadow-2xs">
                <span class="material-symbols-outlined text-[18px]">chat</span>
            </div>
            <div>
                <h2 class="text-xs sm:text-sm font-bold text-zinc-900 dark:text-zinc-100 tracking-tight m-0 leading-none">Published Specs Q&amp;A</h2>
                <span class="text-[10px] text-zinc-400 dark:text-zinc-500 font-mono hidden sm:inline">RAG & Vector Grounded Assistant</span>
            </div>
        </div>

        <div class="flex items-center gap-2.5">
            <!-- Project Selector Pills -->
            <div class="flex items-center gap-1 p-0.5 bg-zinc-100 dark:bg-zinc-800/80 rounded-lg border border-zinc-200/80 dark:border-zinc-700/60 overflow-x-auto max-w-[320px]">
                @foreach (var proj in projects)
                {
                    var isSelected = proj.Id == selectedProjectId;
                    <button class="px-2.5 py-1 rounded-md text-xs font-medium transition-all flex items-center gap-1 whitespace-nowrap cursor-pointer @(isSelected ? "bg-white dark:bg-zinc-900 text-indigo-600 dark:text-indigo-400 shadow-xs border border-zinc-200/80 dark:border-zinc-700 font-semibold" : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200")" @onclick="() => SelectProjectById(proj.Id)">
                        <span class="material-symbols-outlined text-[14px] @(isSelected ? "text-indigo-600 dark:text-indigo-400" : "text-zinc-400")">folder</span>
                        <span>@proj.Name</span>
                    </button>
                }
            </div>

            <span class="badge badge-primary text-[11px] py-1 px-2.5 hidden sm:inline-flex">
                @(vectorStats?.TotalVectorCount ?? 0) Vectors
            </span>

            <button class="btn-secondary text-xs p-1.5 cursor-pointer text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30" @onclick="() => showClearChatModal = true" title="Clear Chat History">
                <span class="material-symbols-outlined text-[16px]">delete</span>
            </button>
        </div>
    </header>

    <!-- Chat Stream Window -->
    <div id="devQaChatStream" class="flex-1 overflow-y-auto px-4 sm:px-6 py-6 w-full">
        <div class="max-w-8xl w-full mx-auto flex flex-col gap-6">

            <!-- In-Stream Lazy Loader -->
            @if (isLoadingOlderMessages)
            {
                <div class="py-2.5 flex items-center justify-center gap-2 text-xs text-indigo-600 dark:text-indigo-400 font-mono animate-in fade-in duration-100">
                    <div class="animate-spin w-4 h-4 border-2 border-indigo-600 border-t-transparent rounded-full"></div>
                    <span>Loading older messages...</span>
                </div>
            }
            else if (hasMoreOlderMessages)
            {
                <div class="py-1 text-center">
                    <button class="text-[11px] text-zinc-400 hover:text-indigo-600 dark:hover:text-indigo-400 font-mono transition-colors cursor-pointer" @onclick="LoadOlderMessagesManually">
                        ↑ Scroll up to load older messages (@(allMessages.Count - chatMessages.Count) older)
                    </button>
                </div>
            }

            @if (isLoadingChat)
            {
                <div class="py-20 flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500 font-mono text-xs">
                    <div class="animate-spin w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full mb-3"></div>
                    <span>Querying vector store knowledge base...</span>
                </div>
            }
            else if (!chatMessages.Any())
            {
                <div class="my-auto flex flex-col items-center justify-center text-center py-12">
                    <div class="w-12 h-12 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-4">
                        <span class="material-symbols-outlined text-2xl">search</span>
                    </div>
                    <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Ask questions about published specifications</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-md mb-6 leading-relaxed">
                        Grounded in the indexed requirements of <strong class="text-zinc-800 dark:text-zinc-200">@(selectedProject?.Name ?? "this project")</strong>.
                    </p>

                    <!-- Prompt Suggestions -->
                    <div class="flex flex-wrap justify-center gap-2 max-w-xl">
                        <button class="btn-secondary text-xs py-1.5 px-3" @onclick='() => UsePrompt("What API endpoint contracts and payload formats are specified for this project?")'>
                            What API contracts are specified?
                        </button>
                        <button class="btn-secondary text-xs py-1.5 px-3" @onclick='() => UsePrompt("List error handling scenarios, HTTP status codes, and exception boundaries.")'>
                            List HTTP error codes &amp; status mapping
                        </button>
                        <button class="btn-secondary text-xs py-1.5 px-3" @onclick='() => UsePrompt("Generate Given-When-Then Gherkin syntax feature files for all published acceptance criteria.")'>
                            Generate Gherkin test scenarios
                        </button>
                        <button class="btn-secondary text-xs py-1.5 px-3" @onclick='() => UsePrompt("Summarize all key acceptance criteria and business rules for this project.")'>
                            Summarize key business rules
                        </button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var msg in chatMessages)
                {
                    if (msg.Role == "assistant" && string.IsNullOrWhiteSpace(msg.Content) && isThinking)
                    {
                        continue;
                    }

                    bool isError = msg.Role == "assistant" && (msg.Content.Contains("[HTTP Error") || msg.Content.StartsWith("[Error") || msg.Content.Contains("[API Warning") || (!isThinking && string.IsNullOrWhiteSpace(msg.Content)));

                    <div class="flex flex-col @(msg.Role == "user" ? "items-end" : "items-start") w-full">
                        <div class="flex items-center gap-1.5 mb-1 px-1 text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
                            @if (msg.Role == "user")
                            {
                                <span class="text-[10px] text-zinc-400 dark:text-zinc-500" title="@FormatMessageTooltip(msg.Timestamp)">
                                    @FormatMessageTime(msg.Timestamp)
                                </span>
                                <span class="text-zinc-300 dark:text-zinc-700">&bull;</span>
                                <span class="font-medium text-indigo-600 dark:text-indigo-400">You</span>
                            }
                            else
                            {
                                <span class="font-medium text-zinc-700 dark:text-zinc-300">Q&amp;A Assistant</span>
                                <span class="text-zinc-300 dark:text-zinc-700">&bull;</span>
                                <span class="text-[10px] text-zinc-400 dark:text-zinc-500" title="@FormatMessageTooltip(msg.Timestamp)">
                                    @FormatMessageTime(msg.Timestamp)
                                </span>
                            }
                        </div>

                        @if (msg.Role == "user")
                        {
                            <div class="bg-indigo-600 text-white rounded-2xl rounded-tr-xs px-5 py-3.5 text-xs leading-relaxed max-w-2xl sm:max-w-3xl whitespace-pre-wrap shadow-xs">
                                @msg.Content
                            </div>
                        }
                        else
                        {
                            <div class="card p-6 w-full flex flex-col gap-3 shadow-xs">
                                @if (isError)
                                {
                                    <div class="flex items-center gap-3">
                                        <span class="text-rose-600 text-xs font-mono">Failed to receive answer</span>
                                        <button class="btn-secondary text-xs py-1 px-2.5" @onclick="RetryLastQuery" disabled="@isThinking">
                                            <span class="material-symbols-outlined text-[14px]">refresh</span>
                                            <span>Retry</span>
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="text-xs text-zinc-800 dark:text-zinc-200 leading-relaxed prose dark:prose-invert max-w-none">
                                        @((MarkupString)Markdig.Markdown.ToHtml(msg.Content))
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (isThinking && string.IsNullOrEmpty(currentStreamingResponse))
                {
                    <div class="flex flex-col items-start w-full animate-in fade-in duration-150">
                        <div class="text-[11px] font-mono font-medium text-zinc-400 dark:text-zinc-500 mb-1 px-1">
                            @(roleMode == "qa_mode" ? "QA Copilot" : "Dev Assistant")
                        </div>
                        <div class="card p-4 flex items-center gap-3 text-xs text-indigo-600 dark:text-indigo-400 font-mono shadow-xs">
                            <div class="animate-spin w-4 h-4 border-2 border-indigo-600 border-t-transparent rounded-full shrink-0"></div>
                            <span>Searching specification vector embeddings &amp; generating answer...</span>
                        </div>
                    </div>
                }
            }

        </div>
    </div>

    <!-- Input Bar -->
    <footer class="p-4 border-t border-zinc-200 dark:border-zinc-800 bg-white/95 dark:bg-zinc-900/95 backdrop-blur-md shrink-0">
        <div class="max-w-4xl mx-auto flex flex-col gap-2">
            <div class="relative flex items-center bg-zinc-50 dark:bg-zinc-950 rounded-2xl border border-zinc-200 dark:border-zinc-800 focus-within:border-indigo-500 dark:focus-within:border-indigo-500 focus-within:ring-2 focus-within:ring-indigo-500/20 transition-all p-1.5 shadow-2xs">
                <textarea id="devQaAssistantInput" class="w-full bg-transparent text-xs text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 px-3 py-2 leading-relaxed resize-none min-h-[48px] max-h-36 border-none outline-none focus:ring-0" placeholder="Ask about endpoints, validations, business logic, or edge cases..." @bind="userPromptInput" @onkeydown="HandleKeyDown" disabled="@isThinking"></textarea>
                <button class="btn-primary p-2.5 rounded-xl shrink-0 h-[40px] w-[40px] flex items-center justify-center self-end mb-0.5 mr-0.5" @onclick="SendDevQaQuery" disabled="@isThinking" title="Send (Enter)">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                </button>
            </div>

            <div class="flex items-center justify-between text-[11px] text-zinc-400 dark:text-zinc-500 font-mono px-1">
                <span>Press <kbd class="px-1.5 py-0.5 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded text-[10px]">Enter</kbd> to ask</span>
                <span>Grounded with PgVector Embeddings</span>
            </div>
        </div>
    </footer>

</div>

<!-- Clear Chat Confirmation Modal -->
@if (showClearChatModal)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => showClearChatModal = false"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-rose-200 dark:border-rose-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">delete_sweep</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Clear Q&amp;A History</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        Are you sure you want to clear the Dev &amp; QA query history for <strong class="text-zinc-900 dark:text-zinc-100">@(selectedProject?.Name ?? "this project")</strong>?
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => showClearChatModal = false" disabled="@isClearingChat">Cancel</button>
                <button class="btn-danger text-xs flex items-center gap-1.5" @onclick="ExecuteClearChat" disabled="@isClearingChat">
                    @if (isClearingChat)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Clearing...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                        <span>Clear History</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? ProjectId { get; set; }

    private List<ProjectDto> projects = new();
    private ProjectDto? selectedProject;
    private Guid selectedProjectId = Guid.Empty;
    private string roleMode = "qa_mode";

    private List<ChatMessageDto> allMessages = new();
    private List<ChatMessageDto> chatMessages = new();
    private const int PageSize = 15;
    private bool isLoadingOlderMessages = false;
    private bool hasMoreOlderMessages => allMessages.Count > chatMessages.Count;
    private DotNetObjectReference<DevQaAssistant>? dotNetRef;

    private ChatMessageDto CreateMessage(string role, string content)
    {
        var lastTs = allMessages.LastOrDefault()?.Timestamp ?? DateTime.UtcNow.AddMinutes(-1);
        var now = DateTime.UtcNow;
        var ts = now > lastTs ? now : lastTs.AddMilliseconds(20);
        return new ChatMessageDto
        {
            Role = role,
            Content = content,
            Timestamp = ts
        };
    }

    private static string FormatMessageTime(DateTime dt)
    {
        if (dt == default || dt == DateTime.MinValue) return "";
        var utc = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        var local = utc.ToLocalTime();
        return local.Date == DateTime.Today
            ? local.ToString("h:mm tt")
            : local.ToString("MMM d, h:mm tt");
    }

    private static string FormatMessageTooltip(DateTime dt)
    {
        if (dt == default || dt == DateTime.MinValue) return "";
        var utc = dt.Kind == DateTimeKind.Utc ? dt : DateTime.SpecifyKind(dt, DateTimeKind.Utc);
        return utc.ToLocalTime().ToString("f");
    }

    private VectorStoreStatsDto? vectorStats;
    private string userPromptInput = "";
    private bool isThinking = false;
    private bool isLoadingChat = false;
    private string currentStreamingResponse = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAuthSessionAsync()) return;
        await LoadProjects();
    }

    private async Task<bool> EnsureAuthSessionAsync()
    {
        try
        {
            var user = await ApiClient.GetCurrentUserAsync();
            if (user != null && user.IsAuthenticated)
            {
                return true;
            }
        }
        catch
        {
        }

        Nav.NavigateTo("/");
        return false;
    }

    private async Task LoadProjects()
    {
        projects = await ApiClient.GetProjectsAsync();
        if (projects.Any())
        {
            if (ProjectId.HasValue && projects.Any(p => p.Id == ProjectId.Value))
            {
                selectedProjectId = ProjectId.Value;
            }
            else
            {
                selectedProjectId = projects.First().Id;
            }

            selectedProject = projects.FirstOrDefault(p => p.Id == selectedProjectId);
            await LoadDbChatSession();
            await LoadVectorStats();
        }
    }

    private async Task SelectProjectById(Guid pId)
    {
        if (selectedProjectId == pId) return;
        selectedProjectId = pId;
        selectedProject = projects.FirstOrDefault(p => p.Id == pId);
        await LoadDbChatSession();
        await LoadVectorStats();
    }

    private async Task OnProjectSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid pId))
        {
            selectedProjectId = pId;
            selectedProject = projects.FirstOrDefault(p => p.Id == pId);
            await LoadDbChatSession();
            await LoadVectorStats();
        }
    }

    private string PersonaModeKey => "qa_mode";

    private async Task LoadVectorStats()
    {
        if (selectedProjectId == Guid.Empty) return;
        vectorStats = await ApiClient.GetVectorStoreStatsAsync(selectedProjectId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("chatScrollManager.initInfiniteScroll", "devQaChatStream", dotNetRef);
        }
    }

    private async Task LoadDbChatSession()
    {
        if (selectedProjectId == Guid.Empty) return;
        isLoadingChat = true;
        StateHasChanged();
        try
        {
            var session = await ApiClient.GetChatSessionAsync(selectedProjectId, PersonaModeKey);
            if (session != null && session.Messages.Any())
            {
                allMessages = session.Messages.OrderBy(m => m.Timestamp).ToList();
                if (allMessages.Count > PageSize)
                {
                    chatMessages = allMessages.Skip(allMessages.Count - PageSize).Take(PageSize).ToList();
                }
                else
                {
                    chatMessages = allMessages.ToList();
                }
            }
            else
            {
                allMessages = new();
                chatMessages = new();
            }
        }
        finally
        {
            isLoadingChat = false;
            StateHasChanged();
            await Task.Delay(100);
            await ScrollToBottom();
        }
    }

    [JSInvokable]
    public async Task<int> OnLoadOlderMessagesAsync()
    {
        if (isLoadingOlderMessages || !hasMoreOlderMessages) return 0;
        isLoadingOlderMessages = true;
        StateHasChanged();

        await Task.Delay(250); // brief smooth animation for loader

        int currentlyLoaded = chatMessages.Count;
        int total = allMessages.Count;
        int toLoad = Math.Min(PageSize, total - currentlyLoaded);

        if (toLoad > 0)
        {
            var olderBatch = allMessages.Skip(total - currentlyLoaded - toLoad).Take(toLoad).ToList();
            chatMessages.InsertRange(0, olderBatch);
        }

        isLoadingOlderMessages = false;
        StateHasChanged();
        return toLoad;
    }

    private async Task LoadOlderMessagesManually()
    {
        await OnLoadOlderMessagesAsync();
    }

    private async Task SaveDbChatSession()
    {
        if (selectedProjectId == Guid.Empty) return;
        await ApiClient.SaveChatMessagesAsync(selectedProjectId, PersonaModeKey, allMessages);
        await LoadVectorStats();
    }

    private void UsePrompt(string promptText)
    {
        userPromptInput = promptText;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendDevQaQuery();
        }
    }

    private async Task SendDevQaQuery()
    {
        if (selectedProjectId == Guid.Empty || isThinking) return;

        var domVal = await JS.InvokeAsync<string>("getChatInputValue", "devQaAssistantInput");
        var prompt = !string.IsNullOrWhiteSpace(domVal) ? domVal.Trim() : (userPromptInput ?? "").Trim();
        if (string.IsNullOrWhiteSpace(prompt)) return;

        userPromptInput = "";
        await JS.InvokeVoidAsync("clearChatInputValue", "devQaAssistantInput");

        var userMsg = CreateMessage("user", prompt);
        var assistantMsg = CreateMessage("assistant", "");

        allMessages.Add(userMsg);
        allMessages.Add(assistantMsg);
        chatMessages.Add(userMsg);
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendDevQaQueryStreamAsync(
                selectedProjectId,
                roleMode,
                allMessages.Take(allMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                });
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task RetryLastQuery()
    {
        if (isThinking || selectedProjectId == Guid.Empty) return;

        if (chatMessages.Any() && chatMessages.Last().Role == "assistant")
        {
            chatMessages.RemoveAt(chatMessages.Count - 1);
        }

        if (allMessages.Any() && allMessages.Last().Role == "assistant")
        {
            allMessages.RemoveAt(allMessages.Count - 1);
        }

        if (!chatMessages.Any(m => m.Role == "user")) return;

        var assistantMsg = CreateMessage("assistant", "");
        allMessages.Add(assistantMsg);
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendDevQaQueryStreamAsync(
                selectedProjectId,
                roleMode,
                allMessages.Take(allMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                });
        }
        catch (Exception ex)
        {
            assistantMsg.Content = $"[HTTP Error 500] {ex.Message}";
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('devQaChatStream'); if(el) { el.scrollTop = el.scrollHeight; }");
        }
        catch
        {
        }
    }

    private bool showClearChatModal = false;
    private bool isClearingChat = false;

    private async Task ExecuteClearChat()
    {
        isClearingChat = true;
        try
        {
            allMessages.Clear();
            chatMessages.Clear();
            if (selectedProjectId != Guid.Empty)
            {
                await ApiClient.ClearChatSessionAsync(selectedProjectId, PersonaModeKey);
                await LoadVectorStats();
            }

            showClearChatModal = false;
        }
        finally
        {
            isClearingChat = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

}
