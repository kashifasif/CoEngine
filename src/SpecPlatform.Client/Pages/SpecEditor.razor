@page "/spec-editor"
@page "/spec-editor/{SpecId:guid}"
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="w-full flex flex-col lg:flex-row gap-8">

    <!-- Main Editor Column -->
    <div class="flex-1 flex flex-col gap-6">

        @if (isLoadingSpec)
        {
            <div class="py-20 flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500 font-mono text-xs">
                <div class="animate-spin w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full mb-3"></div>
                <span>Loading specification editor...</span>
            </div>
        }
        else if (spec != null)
        {
            <!-- Header Actions Bar -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-zinc-200 dark:border-zinc-800">
                <div class="flex items-center gap-2 text-xs">
                    <span class="badge @(spec.Status == "Published" ? "badge-success" : "badge-warning")">
                        v@(spec.CurrentVersionNumber).@(spec.Status == "Published" ? "0" : "draft")
                    </span>
                    <span class="text-zinc-400 dark:text-zinc-500 font-mono">SPEC-00@(spec.Id)</span>
                </div>

                <div class="flex items-center gap-2">
                    <button class="btn-secondary text-xs cursor-pointer" @onclick="DownloadMarkdownAsync" title="Download Markdown (.md) File">
                        <span class="material-symbols-outlined text-[16px] text-emerald-600 dark:text-emerald-400">download</span>
                        <span>Download .md</span>
                    </button>
                    <button class="btn-secondary text-xs text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 cursor-pointer" @onclick="() => showDeleteModal = true" title="Delete Specification">
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                        <span>Delete</span>
                    </button>
                    <button class="btn-secondary text-xs cursor-pointer" @onclick="SaveDraft" disabled="@isSaving">
                        <span>Save Draft</span>
                    </button>
                    <button class="btn-primary text-xs cursor-pointer" @onclick="() => showPublishModal = true" disabled="@isPublishing">
                        <span class="material-symbols-outlined text-[16px]">publish</span>
                        <span>Publish Version</span>
                    </button>
                </div>
            </div>

            <!-- Editor Form Card -->
            <div class="card p-6 flex flex-col gap-5">
                <!-- Title Field -->
                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Specification Title</label>
                    <input type="text" class="form-input text-base font-semibold" placeholder="e.g. Loan Application & Decision Engine" @bind="title" />
                </div>

                <!-- Description Field -->
                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Master Specification Description</label>
                    <textarea class="form-input text-xs leading-relaxed" rows="6" placeholder="Describe the business problem, target personas, and scope..." @bind="description"></textarea>
                </div>

                <!-- Acceptance Criteria Section -->
                <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
                    <div class="flex items-center justify-between mb-3">
                        <label class="text-xs font-medium text-zinc-700 dark:text-zinc-300">Acceptance Criteria (@criteria.Count)</label>
                        <button class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-medium cursor-pointer" @onclick="AddCriterion">+ Add Criterion</button>
                    </div>

                    <div class="flex flex-col gap-2.5">
                        @for (int i = 0; i < criteria.Count; i++)
                        {
                            var idx = i;
                            <div class="flex items-center gap-2 group">
                                <span class="text-xs font-mono text-zinc-400 w-6 text-center shrink-0">#@(idx + 1)</span>
                                <input type="text" class="form-input text-xs" placeholder="Criteria rule or verification step..." @bind="criteria[idx]" />
                                <button class="text-zinc-400 hover:text-rose-600 p-1.5 rounded-md hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors shrink-0 cursor-pointer" @onclick="() => criteria.RemoveAt(idx)" title="Remove">
                                    <span class="material-symbols-outlined text-[16px]">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <!-- Scope Tags -->
                <div class="pt-4 border-t border-zinc-100 dark:border-zinc-800/80">
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Scope Tags (Comma-separated)</label>
                    <input type="text" class="form-input text-xs font-mono" placeholder="api, bff, security, kyc" @bind="tagsRaw" />
                </div>
            </div>
        }
        else
        {
            <div class="card p-12 text-center border-dashed border-zinc-300 dark:border-zinc-800 text-zinc-400 dark:text-zinc-500 font-mono text-xs">
                Select a specification to edit.
            </div>
        }

    </div>

    <!-- Right Sidebar: Version Timeline -->
    <div class="w-full lg:w-80 flex flex-col gap-4 shrink-0">
        <div class="card p-4">
            <h3 class="text-xs font-semibold text-zinc-900 dark:text-zinc-100 uppercase tracking-wider mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-indigo-600 dark:text-indigo-400 text-[18px]">history</span>
                <span>Published Versions</span>
            </h3>

            @if (spec?.Versions != null && spec.Versions.Any())
            {
                <div class="flex flex-col gap-3 relative pl-4 before:absolute before:left-1 before:top-2 before:bottom-2 before:w-px before:bg-zinc-200 dark:before:bg-zinc-800">
                    @foreach (var ver in spec.Versions.OrderByDescending(v => v.VersionNumber))
                    {
                        <div class="relative pl-3">
                            <span class="absolute -left-[15px] top-1.5 w-2 h-2 rounded-full bg-indigo-600 ring-4 ring-white dark:ring-zinc-900"></span>
                            <div class="flex items-center justify-between mb-0.5">
                                <span class="text-xs font-mono font-semibold text-zinc-900 dark:text-zinc-100">v@(ver.VersionNumber)</span>
                                <span class="text-[11px] font-mono text-zinc-400">@ver.PublishedAt.ToLocalTime().ToString("g")</span>
                            </div>
                            <div class="text-[11px] text-zinc-500 dark:text-zinc-400">
                                @ver.AcceptanceCriteria.Count criteria &bull; @ver.ScopeTags.Count tags
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-xs text-zinc-400 dark:text-zinc-500 font-mono py-4 text-center">
                    No published versions yet.
                </div>
            }
        </div>
    </div>

</div>

<!-- Publish Spec Modal Dialog -->
@if (showPublishModal && spec != null)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => showPublishModal = false"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-indigo-200 dark:border-indigo-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">publish</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Publish Release v@(spec.CurrentVersionNumber + 1)</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        Are you ready to publish <strong class="text-zinc-900 dark:text-zinc-100">@title</strong> as Version <strong>v@(spec.CurrentVersionNumber + 1)</strong>? This will create an immutable version snapshot and update the vector embeddings for developer Q&A.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => showPublishModal = false" disabled="@isPublishing">Cancel</button>
                <button class="btn-primary text-xs flex items-center gap-1.5" @onclick="ExecutePublishSpec" disabled="@isPublishing">
                    @if (isPublishing)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Publishing...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">publish</span>
                        <span>Confirm Publish</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Delete Spec Modal Dialog -->
@if (showDeleteModal && spec != null)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => showDeleteModal = false"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-rose-200 dark:border-rose-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">delete_forever</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Delete Specification</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        Are you sure you want to permanently delete <strong class="text-zinc-900 dark:text-zinc-100">@spec.Title</strong>? This action cannot be undone.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => showDeleteModal = false" disabled="@isDeleting">Cancel</button>
                <button class="btn-danger text-xs flex items-center gap-1.5" @onclick="ExecuteDeleteSpec" disabled="@isDeleting">
                    @if (isDeleting)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                        <span>Delete Specification</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? SpecId { get; set; }

    private SpecDto? spec;
    private bool isLoadingSpec = false;
    private bool isSaving = false;
    private bool isPublishing = false;

    private string title = "";
    private string description = "";
    private List<string> criteria = new();
    private string tagsRaw = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAuthSessionAsync()) return;
        await LoadSpec();
    }

    private async Task<bool> EnsureAuthSessionAsync()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "spec_user_session");
            if (!string.IsNullOrWhiteSpace(sessionJson))
            {
                var user = System.Text.Json.JsonSerializer.Deserialize<UserDto>(sessionJson);
                if (user != null && user.IsAuthenticated)
                {
                    ApiClient.SetAuthToken(user.Token);
                    return true;
                }
            }
        }
        catch { }

        Nav.NavigateTo("/");
        return false;
    }

    private async Task LoadSpec()
    {
        if (SpecId.HasValue)
        {
            isLoadingSpec = true;
            try
            {
                spec = await ApiClient.GetSpecAsync(SpecId.Value);
                if (spec != null)
                {
                    title = spec.Title;
                    description = spec.Description;
                    criteria = spec.CurrentAcceptanceCriteria.ToList();
                    tagsRaw = string.Join(", ", spec.CurrentScopeTags);
                }
            }
            finally
            {
                isLoadingSpec = false;
            }
        }
        else
        {
            var projects = await ApiClient.GetProjectsAsync();
            if (projects.Any())
            {
                var specs = await ApiClient.GetSpecsForProjectAsync(projects.First().Id);
                if (specs.Any())
                {
                    SpecId = specs.First().Id;
                    await LoadSpec();
                }
            }
        }
    }

    private void AddCriterion()
    {
        criteria.Add("");
    }

    private async Task SaveDraft()
    {
        if (!SpecId.HasValue || string.IsNullOrWhiteSpace(title)) return;
        isSaving = true;
        try
        {
            var tags = tagsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(t => t.Trim()).ToList();
            await ApiClient.UpdateSpecAsync(SpecId.Value, new UpdateSpecDto
            {
                Title = title.Trim(),
                Description = description.Trim(),
                AcceptanceCriteria = criteria.Where(c => !string.IsNullOrWhiteSpace(c)).ToList(),
                ScopeTags = tags
            });
            await LoadSpec();
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool showPublishModal = false;
    private bool showDeleteModal = false;
    private bool isDeleting = false;

    private async Task ExecutePublishSpec()
    {
        if (!SpecId.HasValue) return;
        isPublishing = true;
        try
        {
            await SaveDraft();
            await ApiClient.PublishSpecAsync(SpecId.Value);
            showPublishModal = false;
            await LoadSpec();
        }
        finally
        {
            isPublishing = false;
        }
    }

    private async Task ExecuteDeleteSpec()
    {
        if (!SpecId.HasValue || isDeleting) return;
        isDeleting = true;
        try
        {
            await ApiClient.DeleteSpecAsync(SpecId.Value);
            showDeleteModal = false;
            Nav.NavigateTo("/specs");
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task DownloadMarkdownAsync()
    {
        if (spec == null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# {title}");
        sb.AppendLine();
        sb.AppendLine($"**Project:** {spec.ProjectName}  ");
        sb.AppendLine($"**Status:** {spec.Status}  ");
        sb.AppendLine($"**Version:** v{spec.CurrentVersionNumber}  ");
        sb.AppendLine($"**Date:** {spec.CreatedAt:yyyy-MM-dd HH:mm:ss} UTC  ");
        sb.AppendLine();
        sb.AppendLine("## Description");
        sb.AppendLine();
        sb.AppendLine(description);
        sb.AppendLine();

        var validCriteria = criteria.Where(ac => !string.IsNullOrWhiteSpace(ac)).ToList();
        if (validCriteria.Any())
        {
            sb.AppendLine("## Acceptance Criteria");
            sb.AppendLine();
            foreach (var ac in validCriteria)
            {
                sb.AppendLine($"- [ ] {ac}");
            }
            sb.AppendLine();
        }

        var validTags = tagsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries).Select(t => t.Trim()).ToList();
        if (validTags.Any())
        {
            sb.AppendLine("## Scope Tags");
            sb.AppendLine();
            sb.AppendLine(string.Join(" ", validTags.Select(t => $"`{t}`")));
            sb.AppendLine();
        }

        var safeTitle = string.Concat((title ?? "Specification").Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
        var fileName = $"{safeTitle}_v{spec.CurrentVersionNumber}.md";
        await JS.InvokeVoidAsync("downloadFileFromText", fileName, sb.ToString(), "text/markdown");
    }
}
