@page "/ai-workspace"
@page "/ai-workspace/{ProjectId:int}"
@page "/po-brainstorming"
@page "/po-brainstorming/{ProjectId:int}"
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="d-flex flex-column flex-lg-row bg-background" style="height: calc(100vh - 64px); max-height: calc(100vh - 64px); overflow: hidden;">

    <!-- Chat Interface (Matching theme/ai_brainstorming_chat/code.html) -->
    <section class="d-flex flex-column border-end border-outline-variant bg-surface-dim p-0 transition-all h-100 overflow-hidden w-100">

        <!-- Chat Header -->
        <div class="px-4 py-3 border-bottom border-outline-variant d-flex justify-content-between align-items-center bg-surface-container-low flex-shrink-0 flex-wrap gap-3">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-primary-custom" style="font-size: 22px;">psychology</span>
                <h5 class="fw-bold text-on-surface mb-0 font-ui me-2">SpecAI Assistant Studio</h5>
            </div>

            <div class="d-flex align-items-center flex-wrap gap-2">
                <select class="form-select form-select-sm form-control-adaptive font-mono fs-xs" value="@selectedProjectId" @onchange="OnProjectSelected" style="width: auto;">
                    @foreach (var p in projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>

                @if (GetUnansweredQuestions().Any())
                {
                    var pendingCount = GetUnansweredQuestions().Count;
                    <span class="badge bg-warning bg-opacity-15 text-warning border border-warning border-opacity-30 font-mono fs-xs px-2 py-1 me-1" title="Answer or skip all pending questions to unlock publishing">
                        ⚠️ @pendingCount Question@(pendingCount > 1 ? "s" : "") Left
                    </span>
                }

                <!-- Import Transcript / Raw Notes CTA -->
                <button class="btn btn-sm btn-outline-primary text-primary font-mono fs-xs py-1 px-2.5 d-flex align-items-center gap-1.5 shadow-sm ms-2" @onclick="OpenIngestModal" title="Import MS Teams meeting transcript, raw notes, or requirements">
                    <span class="material-symbols-outlined" style="font-size: 16px;">upload_file</span>
                    <span>Import</span>
                </button>

                <button class="btn btn-sm btn-secondary-spec p-1 ms-1" @onclick="ClearChat" title="Clear DB History">
                    <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                </button>

                <span class="font-mono text-on-surface-variant fs-xs ms-2 me-1 d-none d-lg-inline">
                    Status: <strong class="text-secondary-custom">Workbench Ready</strong>
                </span>

                <button class="btn btn-sm btn-primary-spec font-mono fs-xs py-1 px-3 d-flex align-items-center gap-1.5 shadow-sm" @onclick="StructureIntoSpec" disabled="@(isStructuring || GetUnansweredQuestions().Any() || !HasSufficientDataToStructure())" title="@(!HasSufficientDataToStructure() ? "Please brainstorm or provide a draft description first" : GetUnansweredQuestions().Any() ? "Please answer or skip remaining questions to publish" : "Structure and publish specification")">
                    @if (isStructuring)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Reviewing &amp; Publishing...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined" style="font-size: 16px;">publish</span>
                        <span class="fw-bold">Publish Spec</span>
                    }
                </button>
            </div>
        </div>

        <!-- Chat Stream Window -->
        <div id="aiWorkspaceChatStream" class="flex-grow-1 overflow-auto p-4 d-flex flex-column gap-3" style="min-height: 0;">

            @if (isLoadingChat)
            {
                <div class="text-center py-5 font-mono text-on-surface-variant">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading DB Chat History...
                </div>
            }
            else if (!chatMessages.Any())
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center py-5">
                    <div class="rounded-circle p-3 mb-3 bg-primary-container bg-opacity-20 d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined text-primary-custom" style="font-size: 32px;">auto_awesome</span>
                    </div>
                    <h6 class="fw-bold text-on-surface">Hello! I'm ready to help you draft your spec.</h6>
                    <p class="text-on-surface-variant small font-mono max-w-sm mb-3" style="max-width: 420px;">
                        What specific requirements, user story, or API security rules would you like to brainstorm for <strong>@(selectedProject?.Name ?? "this project")</strong>?
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <button class="btn btn-sm btn-secondary-spec font-mono fs-xs" @onclick='() => UsePrompt("Let us define user authentication and step-up MFA for loan approval.")'>
                            💡 MFA Authentication Rules
                        </button>
                        <button class="btn btn-sm btn-secondary-spec font-mono fs-xs" @onclick='() => UsePrompt("What API rate limits and HTTP error status codes should be specified?")'>
                            💡 Rate Limiting & Error Codes
                        </button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var msg in chatMessages)
                {
                    bool isError = msg.Role == "assistant" && (msg.Content.Contains("[HTTP Error") || msg.Content.StartsWith("[Error") || msg.Content.Contains("[API Warning") || (!isThinking && string.IsNullOrWhiteSpace(msg.Content)));
                    <div class="d-flex gap-3 @(msg.Role == "user" ? "justify-content-end" : "justify-content-start")">
                        @if (msg.Role != "user")
                        {
                            <div class="rounded-circle bg-primary-container d-flex align-items-center justify-content-center shrink-0" style="width: 32px; height: 32px;">
                                <span class="material-symbols-outlined text-on-primary-container" style="font-size: 16px;">auto_awesome</span>
                            </div>
                        }

                        <div class="p-3 shadow-sm @(msg.Role == "user" ? "chat-bubble-user" : "chat-bubble-ai")" style="max-width: 85%;">
                            <div class="d-flex align-items-center justify-content-between mb-1 opacity-75 fs-xs fw-semibold">
                                <span>@(msg.Role == "user" ? "Product Owner / BA" : "SpecAI Assistant")</span>
                            </div>

                            @if (isError)
                            {
                                <div class="d-flex align-items-center gap-2 py-1">
                                    <button class="btn btn-sm btn-outline-danger text-danger border-danger rounded-pill px-3 py-1.5 font-mono fs-xs d-flex align-items-center gap-2" @onclick="RetryLastQuery" disabled="@isThinking" title="Click to retry answer">
                                        <i class="bi bi-arrow-clockwise fs-5 text-danger"></i>
                                        <span class="fw-bold text-danger">Retry</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                var parsedQuestions = (msg.Role == "assistant") ? ParseQuestionOptions(msg.Content) : new List<ParsedQuestion>();

                                @if (!parsedQuestions.Any())
                                {
                                    <div style="white-space: pre-wrap;" class="small lh-base mb-2">@CleanAnswerTags(msg.Content)</div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-3">
                                        @foreach (var q in parsedQuestions)
                                        {
                                            var qKey = $"{msg.Content.GetHashCode()}_{q.Number}";
                                            bool isEditingManual = activeManualInputQKey == qKey;

                                            <div class="p-3 bg-surface-container-lowest border border-outline-variant rounded-3 shadow-xs">
                                                <div class="d-flex align-items-center justify-content-between mb-2">
                                                    <div class="fw-semibold text-on-surface fs-xs">
                                                        <span class="badge bg-primary-container text-on-primary-container font-mono me-1.5">Q@(q.Number)</span>
                                                        @q.QuestionText
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(q.SelectedAnswer))
                                                    {
                                                        <span class="status-badge-success">
                                                            ✔ Answered
                                                        </span>
                                                    }
                                                </div>

                                                <!-- Suggested Options & Action Buttons -->
                                                <div class="d-flex flex-column gap-2 mt-3">
                                                    @foreach (var opt in q.Options)
                                                    {
                                                        bool isSelected = q.SelectedAnswer == opt;
                                                        <button class="btn text-start @(isSelected ? "btn-success text-white shadow-sm" : "btn-outline-secondary text-on-surface-variant") font-mono fs-xs py-2 px-3 rounded-2 d-flex align-items-center gap-2"
                                                                @onclick="() => SaveInlineMCQAnswer(msg, q.Number, opt)"
                                                                disabled="@isThinking" style="white-space: normal; transition: all 0.2s ease;">
                                                            @if (isSelected)
                                                            {
                                                                <span class="material-symbols-outlined" style="font-size: 16px;">radio_button_checked</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="material-symbols-outlined" style="font-size: 16px; opacity: 0.5;">radio_button_unchecked</span>
                                                            }
                                                            <span style="flex:1;">@opt</span>
                                                        </button>
                                                    }

                                                    <div class="d-flex flex-wrap gap-2 mt-1">
                                                        <!-- Manual Answer Option -->
                                                        <button class="btn btn-sm @(q.SelectedAnswer.StartsWith("Manual:") ? "btn-primary text-white shadow-sm" : "btn-outline-primary") font-mono fs-xs py-1.5 px-3 rounded-2 d-flex align-items-center gap-1.5"
                                                                @onclick="() => ToggleManualInput(qKey)"
                                                                disabled="@isThinking"
                                                                title="Type custom manual response">
                                                            <span class="material-symbols-outlined" style="font-size: 14px;">edit_note</span>
                                                            <span>Custom Manual Answer</span>
                                                        </button>

                                                        <!-- Skip Question Option -->
                                                        <button class="btn btn-sm @(q.SelectedAnswer == "Not sure yet" ? "btn-warning text-dark shadow-sm" : "btn-outline-warning") font-mono fs-xs py-1.5 px-3 rounded-2 d-flex align-items-center gap-1.5"
                                                                @onclick="() => SkipInlineMCQQuestion(msg, q.Number)"
                                                                disabled="@isThinking"
                                                                title="Mark as Not sure yet">
                                                            <span class="material-symbols-outlined" style="font-size: 14px;">forward</span>
                                                            <span>Skip ("Not sure yet")</span>
                                                        </button>
                                                    </div>
                                                </div>

                                                <!-- Inline Manual Answer Field -->
                                                @if (isEditingManual)
                                                {
                                                    <div class="mt-2.5 p-2 bg-surface-container-low border border-outline-variant rounded-2 d-flex align-items-center gap-2 shadow-xs">
                                                        <input type="text" class="form-control form-control-sm form-control-adaptive font-mono fs-xs border-0 bg-transparent" placeholder="Type custom answer for Q@q.Number..." @bind="manualInputText" style="box-shadow: none;"/>
                                                        <button class="btn btn-sm btn-primary font-mono fs-xs py-1 px-3 rounded-2 shadow-sm" @onclick="() => SaveManualInputAnswer(msg, q.Number)">
                                                            Save
                                                        </button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }

                @if (isThinking && string.IsNullOrEmpty(currentStreamingResponse))
                {
                    <div class="d-flex gap-2 align-items-center text-on-surface-variant small font-mono">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <span>Streaming AI requirement response...</span>
                    </div>
                }
            }

        </div>

        <!-- Chat Input Bar -->
        <div class="p-3 border-top border-outline-variant bg-surface-container-lowest">
            <div class="input-group mb-2">
                <textarea id="aiWorkspaceInput" class="form-control form-control-adaptive font-mono fs-sm" rows="3" placeholder="Describe your feature idea freely in Phase 1 (Listening Mode)..." @bind="userPromptInput" @onkeydown="HandleKeyDown" disabled="@isThinking"></textarea>
                <button class="btn btn-primary-spec px-4 d-flex align-items-center justify-content-center" @onclick="() => SendChatMessage(false)" disabled="@isThinking" title="Send brainstorming text (Phase 1 Listening Mode)">
                    <span class="material-symbols-outlined">send</span>
                </button>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 font-mono fs-xs text-on-surface-variant">
                <span><span class="material-symbols-outlined" style="font-size: 14px;">keyboard</span> Enter to send (Listening Mode)</span>

                <button class="btn btn-sm btn-outline-primary text-primary font-mono fs-xs py-1 px-3 d-flex align-items-center justify-content-center gap-1.5 shadow-sm" @onclick="TriggerClarificationRound" disabled="@(isThinking || !chatMessages.Any())" title="Trigger Phase 2 Clarification Round to ask up to 5 clarifying questions">
                    <span class="material-symbols-outlined" style="font-size: 16px;">help_center</span>
                    <strong>Start Clarification Round</strong>
                </button>
            </div>
        </div>

    </section>


</div>

@* ─── Self-Review Warning Panel ─────────────────────────────────────────── *@
@if (showSelfReviewPanel && selfReviewResult != null)
{
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.70); z-index: 1050;"></div>

    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content bg-surface-container-high border border-outline-variant rounded-4 shadow-lg text-on-surface">

                @* Modal Header *@
                <div class="modal-header border-bottom border-outline-variant px-4 py-3"
                     style="background: linear-gradient(135deg, rgba(234,179,8,0.12) 0%, rgba(239,68,68,0.08) 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 d-flex align-items-center justify-content-center"
                             style="background: rgba(234,179,8,0.2); width:40px; height:40px;">
                            <span class="material-symbols-outlined" style="font-size:22px; color:#ca8a04;">policy</span>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 font-ui">
                                @if (selfReviewResult.Passed)
                                {
                                    <span class="text-success">✅ Spec Quality Checks Passed</span>
                                }
                                else
                                {
                                    var issueCount = CountSelfReviewIssues();
                                    <span style="color:#b45309;">⚠️ @issueCount Issue@(issueCount == 1 ? "" : "s") Found — Review Before Publishing</span>
                                }
                            </h5>
                            <span class="font-mono fs-xs text-on-surface-variant">Self-Review Checklist ran automatically on the structured spec</span>
                        </div>
                    </div>
                </div>

                @* Modal Body *@
                <div class="modal-body px-4 py-3 d-flex flex-column gap-3">

                    @* Auto-fix disclosure *@
                    @if (selfReviewResult.AutoFixes.Any())
                    {
                        <div class="p-3 rounded-3 border d-flex flex-column gap-2"
                             style="background: rgba(59,130,246,0.08); border-color: rgba(59,130,246,0.3) !important;">
                            <div class="d-flex align-items-center gap-2 fw-semibold font-mono fs-xs" style="color:#3b82f6;">
                                <span class="material-symbols-outlined" style="font-size:16px;">auto_fix_high</span>
                                <span>Auto-Fixed (@selfReviewResult.AutoFixes.Count) — Review &amp; revert if inaccurate</span>
                            </div>
                            <ul class="mb-0 ps-3 font-mono fs-xs text-on-surface-variant" style="list-style: disc;">
                                @foreach (var fix in selfReviewResult.AutoFixes)
                                {
                                    <li>@fix</li>
                                }
                            </ul>
                        </div>
                    }

                    @* Four check rows *@
                    <div class="d-flex flex-column gap-2">
                        @RenderCheckRow("Placeholder Scan", selfReviewResult.Checks.PlaceholderScan, "scan")
                        @RenderCheckRow("Internal Consistency", selfReviewResult.Checks.InternalConsistency, "compare_arrows")
                        @RenderCheckRow("Scope Check", selfReviewResult.Checks.ScopeCheck, "adjust")
                        @RenderCheckRow("Ambiguity Check", selfReviewResult.Checks.AmbiguityCheck, "help_center")
                    </div>

                    @if (!selfReviewResult.Passed)
                    {
                        <div class="p-2 rounded-2 font-mono fs-xs text-on-surface-variant border border-outline-variant"
                             style="background: rgba(234,179,8,0.06);">
                            <span class="material-symbols-outlined me-1" style="font-size:14px; vertical-align:middle;">info</span>
                            Publishing is not blocked — you retain final control. Issues above are for your review only.
                        </div>
                    }
                </div>

                @* Modal Footer *@
                <div class="modal-footer border-top border-outline-variant px-4 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary font-mono px-3"
                            @onclick="CancelSelfReviewAndReset"
                            disabled="@isPublishing">
                        <span class="material-symbols-outlined me-1" style="font-size:15px;">close</span>
                        Cancel
                    </button>

                    <button type="button" class="btn btn-primary-spec font-mono px-4 d-flex align-items-center gap-2"
                            @onclick="ConfirmPublishAfterReview"
                            disabled="@isPublishing">
                        @if (isPublishing)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Publishing...</span>
                        }
                        else if (selfReviewResult.Passed)
                        {
                            <span class="material-symbols-outlined" style="font-size:18px;">publish</span>
                            <span class="fw-bold">Publish</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size:18px;">warning</span>
                            <span class="fw-bold">Publish Anyway</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@if (showIngestModal)
{
    <!-- Import Raw Requirements / Transcript Modal Backdrop -->
    <div class="modal-backdrop fade show" style="background-color: rgba(0,0,0,0.65); z-index: 1050;" @onclick="CloseIngestModal"></div>

    <div class="modal fade show d-block" tabindex="-1" style="z-index: 1055;" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content bg-surface-container-high border border-outline-variant rounded-4 shadow-lg text-on-surface">

                <!-- Modal Header -->
                <div class="modal-header border-bottom border-outline-variant px-4 py-3 bg-surface-container">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle p-2 bg-primary bg-opacity-15 text-primary-custom d-flex align-items-center justify-content-center">
                            <span class="material-symbols-outlined" style="font-size: 22px;">description</span>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0 font-ui text-on-surface">Import Raw Requirements & Meeting Transcripts</h5>
                            <span class="text-on-surface-variant font-mono fs-xs">Feed MS Teams logs, Zoom transcripts, client emails, or Jira stories into SpecAI</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseIngestModal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body px-4 py-3 d-flex flex-column gap-3">

                    <!-- Source Tag & Info Row -->
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label font-mono text-primary-custom fs-xs fw-bold mb-1">SOURCE TYPE</label>
                            <select class="form-select form-select-sm form-control-adaptive font-mono fs-xs" @bind="rawSourceTag">
                                <option value="MS Teams Meeting Transcript">🎙️ MS Teams Meeting Transcript</option>
                                <option value="Zoom / Call Transcript">📹 Zoom / Call Transcript</option>
                                <option value="Sprint Grooming Notes">📋 Sprint Grooming Notes</option>
                                <option value="Client Requirements Email / PRD">📄 Client Requirements Email / PRD</option>
                                <option value="Jira / User Story Dump">🎫 Jira / User Story Dump</option>
                                <option value="Raw Written Notes">✍️ Raw Written Notes</option>
                            </select>
                        </div>

                        <div class="col-12 col-md-6">
                            <label class="form-label font-mono text-primary-custom fs-xs fw-bold mb-1">OR UPLOAD FILE (.txt, .md, .vtt, .json)</label>
                            <InputFile OnChange="HandleTranscriptFileUpload" class="form-control form-control-sm form-control-adaptive font-mono fs-xs" accept=".txt,.md,.vtt,.json"/>
                        </div>
                    </div>

                    <!-- Raw Content Textarea -->
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label font-mono text-primary-custom fs-xs fw-bold mb-0">PASTE RAW TRANSCRIPT / NOTES CONTENT</label>
                            @if (!string.IsNullOrWhiteSpace(rawTranscriptText))
                            {
                                <span class="font-mono text-secondary-custom fs-xs">@rawTranscriptText.Length characters loaded</span>
                            }
                        </div>
                        <textarea class="form-control form-control-adaptive font-mono fs-xs" rows="8" placeholder="Paste your raw text here, for example:&#10;&#10;Alice: For the new loan checkout, we must enforce MFA for anything over $10k.&#10;Bob: Agreed. And if the credit bureau times out after 3 seconds, return a 504 Gateway Timeout.&#10;Charlie: Also make sure we audit log all requests in pgvector..." @bind="rawTranscriptText"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(ingestError))
                    {
                        <div class="alert alert-danger font-mono fs-xs py-2 px-3 mb-0 border-0 rounded-2">
                            ⚠️ @ingestError
                        </div>
                    }

                    <!-- Info Alert -->
                    <div class="p-2.5 bg-surface-container border border-outline-variant rounded-3 font-mono fs-xs text-on-surface-variant d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined text-primary-custom" style="font-size: 18px;">auto_awesome</span>
                        <span>SpecAI will index the full transcript into <strong>PostgreSQL pgvector</strong> and pre-populate the live draft on the right.</span>
                    </div>

                </div>

                <!-- Modal Footer -->
                <div class="modal-footer border-top border-outline-variant px-4 py-3 d-flex justify-content-between">
                    <button type="button" class="btn btn-sm btn-outline-secondary font-mono px-3" @onclick="CloseIngestModal" disabled="@isIngesting">Cancel</button>

                    <button type="button" class="btn btn-primary-spec font-mono px-4 d-flex align-items-center gap-2" @onclick="SubmitIngestTranscript" disabled="@(isIngesting || string.IsNullOrWhiteSpace(rawTranscriptText))">
                        @if (isIngesting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Analyzing & Indexing Transcript...</span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined" style="font-size: 18px;">smart_toy</span>
                            <span class="fw-bold">Ingest & Analyze with SpecAI</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? ProjectId { get; set; }

    private List<ProjectDto> projects = new();
    private ProjectDto? selectedProject;
    private int selectedProjectId = 0;

    private List<ChatMessageDto> chatMessages = new();
    private string userPromptInput = "";
    private bool isThinking = false;
    private bool isLoadingChat = false;
    private string currentStreamingResponse = "";

    private bool isStructuring = false;

    // ─── Self-Review Panel State ────────────────────────────────────────────
    private bool showSelfReviewPanel = false;
    private bool isPublishing = false;
    private SelfReviewResultDto? selfReviewResult = null;
    private StructuredSpecResultDto? pendingStructuredResult = null;

    // Panel state

    // Transcript Ingestion State
    private bool showIngestModal = false;
    private string rawTranscriptText = "";
    private string rawSourceTag = "MS Teams Meeting Transcript";
    private bool isIngesting = false;
    private string ingestError = "";

    private void OpenIngestModal()
    {
        showIngestModal = true;
        ingestError = "";
    }

    private void CloseIngestModal()
    {
        if (!isIngesting)
        {
            showIngestModal = false;
            ingestError = "";
        }
    }

    private async Task HandleTranscriptFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var reader = new System.IO.StreamReader(stream);
                rawTranscriptText = await reader.ReadToEndAsync();

                if (file.Name.EndsWith(".vtt", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "MS Teams Meeting Transcript (.vtt)";
                }
                else if (file.Name.Contains("teams", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "MS Teams Meeting Transcript";
                }
                else if (file.Name.Contains("zoom", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "Zoom Call Transcript";
                }
                else if (file.Name.Contains("jira", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "Jira User Story Dump";
                }

                ingestError = "";
            }
        }
        catch (Exception ex)
        {
            ingestError = $"Error reading file: {ex.Message}";
        }
    }

    private async Task SubmitIngestTranscript()
    {
        if (string.IsNullOrWhiteSpace(rawTranscriptText) || selectedProjectId == 0) return;

        isIngesting = true;
        ingestError = "";

        try
        {
            var result = await ApiClient.IngestRawTranscriptAsync(selectedProjectId, rawSourceTag, rawTranscriptText);

            if (result != null && result.Success)
            {
                chatMessages.Add(new ChatMessageDto
                {
                    Role = "user",
                    Content = $"[Uploaded Raw Transcript - {rawSourceTag}]:\n{rawTranscriptText.Substring(0, Math.Min(400, rawTranscriptText.Length))}..."
                });

                chatMessages.Add(new ChatMessageDto
                {
                    Role = "assistant",
                    Content = result.SummaryReply
                });

                showIngestModal = false;
                rawTranscriptText = "";


                await ScrollToBottom();
            }
            else
            {
                ingestError = "Failed to process transcript. Please ensure the API is running and try again.";
            }
        }
        catch (Exception ex)
        {
            ingestError = $"Error: {ex.Message}";
        }
        finally
        {
            isIngesting = false;
        }
    }

