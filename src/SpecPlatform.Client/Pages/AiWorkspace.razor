    private async Task LoadDbChatSession()
    {
        if (selectedProjectId == 0) return;
        isLoadingChat = true;
        StateHasChanged();
        try
        {
            var session = await ApiClient.GetChatSessionAsync(selectedProjectId, PersonaModeKey);
            if (session != null && session.Messages.Any())
            {
                chatMessages = session.Messages;
            }
            else
            {
                chatMessages = new();
            }
        }
        finally
        {
            isLoadingChat = false;
            StateHasChanged();
            await Task.Delay(100);
            await ScrollToBottom();
        }
    }

    private async Task SaveDbChatSession()
    {
        if (selectedProjectId == 0) return;
        await ApiClient.SaveChatMessagesAsync(selectedProjectId, PersonaModeKey, chatMessages);
    }

    private void UsePrompt(string text)
    {
        userPromptInput = text;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendChatMessage();
        }
    }

    private async Task SendChatMessage(bool isClarificationPhase = false)
    {
        if (selectedProjectId == 0 || isThinking) return;

        var domVal = await JS.InvokeAsync<string>("getChatInputValue", "aiWorkspaceInput");
        var prompt = !string.IsNullOrWhiteSpace(domVal) ? domVal.Trim() : (userPromptInput ?? "").Trim();
        if (string.IsNullOrWhiteSpace(prompt)) return;

        userPromptInput = "";
        await JS.InvokeVoidAsync("clearChatInputValue", "aiWorkspaceInput");

        chatMessages.Add(new ChatMessageDto { Role = "user", Content = prompt });
        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                },
                isClarificationPhase: isClarificationPhase);
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task TriggerClarificationRound()
    {
        if (selectedProjectId == 0 || isThinking) return;

        if (!string.IsNullOrWhiteSpace(userPromptInput))
        {
            var prompt = userPromptInput.Trim();
            userPromptInput = "";
            chatMessages.Add(new ChatMessageDto { Role = "user", Content = prompt });
        }

        if (!chatMessages.Any()) return;

        // Check if the most recent assistant message already contains questions or completed clarification status
        var lastAssistantMsg = chatMessages.LastOrDefault(m => m.Role == "assistant");
        if (lastAssistantMsg != null)
        {
            var questions = ParseQuestionOptions(lastAssistantMsg.Content);
            if (questions.Any())
            {
                var unanswered = questions.Where(q => string.IsNullOrEmpty(q.SelectedAnswer)).ToList();
                if (unanswered.Any())
                {
                    var qNumbers = string.Join(", ", unanswered.Select(u => $"Q{u.Number}"));
                    chatMessages.Add(new ChatMessageDto
                    {
                        Role = "assistant",
                        Content = $"ℹ️ **Pending Questions Remaining:** Please select or skip the remaining unanswered question(s) above ({qNumbers}) before requesting further clarification."
                    });
                    await SaveDbChatSession();
                    StateHasChanged();
                    await ScrollToBottom();
                    return;
                }
            }
            else if (lastAssistantMsg.Content.Contains("fully clarified") ||
                     lastAssistantMsg.Content.Contains("No clarifying questions needed") ||
                     lastAssistantMsg.Content.Contains("Fully Clarified"))
            {
                chatMessages.Add(new ChatMessageDto
                {
                    Role = "assistant",
                    Content = "✅ **Fully Clarified:** All feature requirements have already been clarified! Click **Structure & Publish Spec** when ready."
                });
                await SaveDbChatSession();
                StateHasChanged();
                await ScrollToBottom();
                return;
            }
        }

        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                },
                isClarificationPhase: true);
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task RetryLastQuery()
    {
        if (isThinking || selectedProjectId == 0) return;

        if (chatMessages.Any() && chatMessages.Last().Role == "assistant")
        {
            chatMessages.RemoveAt(chatMessages.Count - 1);
        }

        if (!chatMessages.Any(m => m.Role == "user")) return;

        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                });
        }
        catch (Exception ex)
        {
            assistantMsg.Content = $"[HTTP Error 500] {ex.Message}";
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

