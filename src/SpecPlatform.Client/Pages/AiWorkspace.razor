@page "/ai-workspace"
@page "/ai-workspace/{ProjectId:int}"
@page "/po-brainstorming"
@page "/po-brainstorming/{ProjectId:int}"
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="d-flex flex-column flex-lg-row h-100 bg-background" style="min-height: calc(100vh - 64px);">

    <!-- Left Panel: Chat Interface (Matching theme/ai_brainstorming_chat/code.html) -->
    <section class="flex-grow-1 d-flex flex-column border-end border-outline-variant bg-surface-dim p-0" style="max-width: 48%; min-width: 360px;">
        
        <!-- Chat Header -->
        <div class="px-4 py-3 border-bottom border-outline-variant d-flex justify-content-between align-items-center bg-surface-container-low">
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-primary-custom" style="font-size: 22px;">psychology</span>
                <h5 class="fw-bold text-on-surface mb-0 font-ui">SpecAI Assistant Studio</h5>
            </div>
            
            <div class="d-flex align-items-center gap-2">
                <select class="form-select form-select-sm form-control-adaptive font-mono fs-xs" value="@selectedProjectId" @onchange="OnProjectSelected">
                    @foreach (var p in projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>

                <button class="btn btn-sm btn-secondary-spec p-1" @onclick="ClearChat" title="Clear DB History">
                    <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                </button>
            </div>
        </div>

        <!-- Chat Stream Window -->
        <div id="aiWorkspaceChatStream" class="flex-grow-1 overflow-auto p-4 d-flex flex-column gap-3" style="max-height: calc(100vh - 200px);">

            @if (isLoadingChat)
            {
                <div class="text-center py-5 font-mono text-on-surface-variant">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div> Loading DB Chat History...
                </div>
            }
            else if (!chatMessages.Any())
            {
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center py-5">
                    <div class="rounded-circle p-3 mb-3 bg-primary-container bg-opacity-20 d-flex align-items-center justify-content-center">
                        <span class="material-symbols-outlined text-primary-custom" style="font-size: 32px;">auto_awesome</span>
                    </div>
                    <h6 class="fw-bold text-on-surface">Hello! I'm ready to help you draft your spec.</h6>
                    <p class="text-on-surface-variant small font-mono max-w-sm mb-3" style="max-width: 420px;">
                        What specific requirements, user story, or API security rules would you like to brainstorm for <strong>@(selectedProject?.Name ?? "this project")</strong>?
                    </p>

                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        <button class="btn btn-sm btn-secondary-spec font-mono fs-xs" @onclick='() => UsePrompt("Let us define user authentication and step-up MFA for loan approval.")'>
                            💡 MFA Authentication Rules
                        </button>
                        <button class="btn btn-sm btn-secondary-spec font-mono fs-xs" @onclick='() => UsePrompt("What API rate limits and HTTP error status codes should be specified?")'>
                            💡 Rate Limiting & Error Codes
                        </button>
                    </div>
                </div>
            }
            else
            {
                @foreach (var msg in chatMessages)
                {
                    bool isError = msg.Role == "assistant" && (msg.Content.Contains("[HTTP Error") || msg.Content.StartsWith("[Error") || msg.Content.Contains("[API Warning") || string.IsNullOrWhiteSpace(msg.Content));
                    <div class="d-flex gap-3 @(msg.Role == "user" ? "justify-content-end" : "justify-content-start")">
                        @if (msg.Role != "user")
                        {
                            <div class="rounded-circle bg-primary-container d-flex align-items-center justify-content-center shrink-0" style="width: 32px; height: 32px;">
                                <span class="material-symbols-outlined text-on-primary-container" style="font-size: 16px;">auto_awesome</span>
                            </div>
                        }

                        <div class="p-3 shadow-sm @(msg.Role == "user" ? "chat-bubble-user" : "chat-bubble-ai")" style="max-width: 85%;">
                            <div class="d-flex align-items-center justify-content-between mb-1 opacity-75 fs-xs fw-semibold">
                                <span>@(msg.Role == "user" ? "Product Owner / BA" : "SpecAI Assistant")</span>
                            </div>

                            @if (isError)
                            {
                                <div class="d-flex align-items-center gap-2 py-1">
                                    <button class="btn btn-sm btn-outline-danger text-danger border-danger rounded-pill px-3 py-1.5 font-mono fs-xs d-flex align-items-center gap-2" @onclick="RetryLastQuery" disabled="@isThinking" title="Click to retry answer">
                                        <i class="bi bi-arrow-clockwise fs-5 text-danger"></i>
                                        <span class="fw-bold text-danger">Retry</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div style="white-space: pre-wrap;" class="small lh-base mb-2">@msg.Content</div>

                                @if (msg.Role == "assistant" && !isThinking)
                                {
                                    var parsedQuestions = ParseQuestionOptions(msg.Content);
                                    if (parsedQuestions.Any())
                                    {
                                        <div class="mt-3 pt-2 border-top border-outline-variant d-flex flex-column gap-3">
                                            @foreach (var q in parsedQuestions)
                                            {
                                                <div class="p-2.5 bg-surface-container-lowest border border-outline-variant rounded-3">
                                                    <div class="fw-semibold text-on-surface fs-xs mb-2">
                                                        <span class="badge bg-primary-container text-on-primary-container font-mono me-1">Q@q.Number</span>
                                                        @q.QuestionText
                                                    </div>
                                                    
                                                    <!-- Suggested Options & Actions -->
                                                    <div class="d-flex flex-wrap gap-1.5 align-items-center">
                                                        @foreach (var opt in q.Options)
                                                        {
                                                            <button class="btn btn-sm btn-outline-secondary font-mono fs-xs py-1 px-2.5 rounded-pill" @onclick="() => SelectOptionAnswer(q.Number, opt)" disabled="@isThinking">
                                                                @opt
                                                            </button>
                                                        }
                                                        
                                                        <!-- Manual Answer Option -->
                                                        <button class="btn btn-sm btn-outline-primary font-mono fs-xs py-1 px-2.5 rounded-pill d-flex align-items-center gap-1" @onclick="() => SelectManualAnswer(q.Number)" disabled="@isThinking" title="Type custom manual response">
                                                            <span>✍️ Manual Answer</span>
                                                        </button>

                                                        <!-- Skip Question Option -->
                                                        <button class="btn btn-sm btn-outline-warning font-mono fs-xs py-1 px-2.5 rounded-pill d-flex align-items-center gap-1" @onclick="() => SkipQuestion(q.Number)" disabled="@isThinking" title="Mark as Not sure yet">
                                                            <span>⏭️ Skip ("Not sure yet")</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                            }
                        </div>
                    </div>
                }

                @if (isThinking && string.IsNullOrEmpty(currentStreamingResponse))
                {
                    <div class="d-flex gap-2 align-items-center text-on-surface-variant small font-mono">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <span>Streaming AI requirement response...</span>
                    </div>
                }
            }

        </div>

        <!-- Chat Input Bar -->
        <div class="p-3 border-top border-outline-variant bg-surface-container-lowest">
            <div class="input-group mb-2">
                <textarea class="form-control form-control-adaptive font-mono fs-sm" rows="3" placeholder="Describe your feature idea freely in Phase 1 (Listening Mode)..." @bind="userPromptInput" @bind:event="oninput" @onkeydown="HandleKeyDown" disabled="@isThinking"></textarea>
                <button class="btn btn-primary-spec px-4 d-flex align-items-center justify-content-center" @onclick="() => SendChatMessage(false)" disabled="@(isThinking || string.IsNullOrWhiteSpace(userPromptInput))" title="Send brainstorming text (Phase 1 Listening Mode)">
                    <span class="material-symbols-outlined">send</span>
                </button>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 font-mono fs-xs text-on-surface-variant">
                <span><span class="material-symbols-outlined" style="font-size: 14px;">keyboard</span> Enter to send (Listening Mode)</span>

                <button class="btn btn-sm btn-outline-primary text-primary font-mono fs-xs py-1 px-3 d-flex align-items-center justify-content-center gap-1.5 shadow-sm" @onclick="TriggerClarificationRound" disabled="@(isThinking || !chatMessages.Any())" title="Trigger Phase 2 Clarification Round to ask up to 5 clarifying questions">
                    <span class="material-symbols-outlined" style="font-size: 16px;">help_center</span>
                    <strong>Start Clarification Round</strong>
                </button>
            </div>
        </div>

    </section>

    <!-- Right Panel: Live Draft Preview (Matching theme/ai_brainstorming_chat/code.html) -->
    <section class="flex-grow-1 d-flex flex-column bg-background p-4 relative overflow-auto" style="min-width: 400px;">
        
        <!-- Live Sync Header -->
        <div class="pb-3 border-bottom border-outline-variant d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold text-on-surface mb-0 d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-secondary-custom">visibility</span> Live Draft Preview
            </h5>

            <div class="d-flex align-items-center gap-2 font-mono fs-xs text-secondary-custom">
                <span class="spinner-grow spinner-grow-sm text-secondary-custom"></span>
                <span>Synced with chat</span>
            </div>
        </div>

        <div class="d-flex flex-column gap-4 flex-grow-1">

            <!-- Spec Title Group -->
            <div>
                <label class="font-mono text-primary-custom fs-xs fw-bold tracking-wider mb-1 block">SPEC TITLE</label>
                <input type="text" class="form-control form-control-adaptive fw-bold fs-5 text-on-surface" placeholder="Loan Approval Workflow & Security" @bind="draftTitle" />
            </div>

            <!-- Metadata Row -->
            <div class="d-flex gap-3 p-2 bg-surface-container-low border border-outline-variant rounded font-mono fs-xs text-on-surface-variant">
                <div>Owner: <strong class="text-on-surface">AI Draft</strong></div>
                <div>Tag: <strong class="text-on-surface">v0.1-draft</strong></div>
                <div>Status: <strong class="text-secondary-custom">Drafting</strong></div>
            </div>

            <!-- Description Group -->
            <div>
                <label class="font-mono text-primary-custom fs-xs fw-bold tracking-wider mb-1 block">DESCRIPTION</label>
                <textarea class="form-control form-control-adaptive" rows="3" placeholder="Detailed description of specification intent..." @bind="draftDesc"></textarea>
            </div>

            <!-- Acceptance Criteria Bento Cards -->
            <div>
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="font-mono text-primary-custom fs-xs fw-bold tracking-wider mb-0">ACCEPTANCE CRITERIA</label>
                    <button class="btn btn-sm btn-link text-primary-custom font-mono text-decoration-none p-0 fs-xs" @onclick="AddDraftCriterion">+ Add Manual</button>
                </div>

                <div class="d-flex flex-column gap-2">
                    @for (int i = 0; i < draftCriteria.Count; i++)
                    {
                        var idx = i;
                        <div class="bento-criteria-card d-flex align-items-start justify-content-between gap-3">
                            <div class="d-flex gap-2">
                                <span class="material-symbols-outlined text-secondary-custom me-1" style="font-size: 18px;">check_circle</span>
                                <div>
                                    <div class="fw-semibold text-on-surface small mb-1">Criterion #@(idx+1)</div>
                                    <input type="text" class="form-control form-control-adaptive font-mono fs-xs" @bind="draftCriteria[idx]" />
                                </div>
                            </div>

                            <button class="btn p-0 text-on-surface-variant hover-danger" @onclick="() => draftCriteria.RemoveAt(idx)">
                                <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>

        <!-- Footer Action Button (Publish to Master Specification) -->
        <div class="pt-3 border-top border-outline-variant mt-4 d-flex justify-content-between align-items-center">
            <span class="font-mono text-on-surface-variant fs-xs">Status: <strong class="text-secondary-custom">Brainstorming Workbench Active</strong></span>
            
            <button class="btn btn-primary-spec font-mono py-2.5 px-4 d-flex align-items-center gap-2" @onclick="StructureIntoSpec" disabled="@isStructuring">
                @if (isStructuring)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <span>Publishing Master Spec...</span>
                }
                else
                {
                    <span class="material-symbols-outlined">publish</span>
                    <span>Structure & Publish Spec</span>
                }
            </button>
        </div>

    </section>

</div>

@code {
    [Parameter] public int? ProjectId { get; set; }

    private List<ProjectDto> projects = new();
    private ProjectDto? selectedProject;
    private int selectedProjectId = 0;

    private List<ChatMessageDto> chatMessages = new();
    private string userPromptInput = "";
    private bool isThinking = false;
    private bool isLoadingChat = false;
    private string currentStreamingResponse = "";

    // Draft Preview state
    private string draftTitle = "Loan Approval Workflow & Security";
    private string draftDesc = "Defines technical requirements for personal loan origination and risk evaluation.";
    private List<string> draftCriteria = new List<string>
    {
        "MFA via Entra ID required before final approval on loans > $10,000.",
        "Return 400 Bad Request with standardized error payload if income validation fails."
    };

    private bool isStructuring = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        projects = await ApiClient.GetProjectsAsync();
        if (projects.Any())
        {
            if (ProjectId.HasValue && projects.Any(p => p.Id == ProjectId.Value))
            {
                selectedProjectId = ProjectId.Value;
            }
            else
            {
                selectedProjectId = projects.First().Id;
            }
            selectedProject = projects.FirstOrDefault(p => p.Id == selectedProjectId);
            await LoadDbChatSession();
        }
    }

    private async Task OnProjectSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int pId))
        {
            selectedProjectId = pId;
            selectedProject = projects.FirstOrDefault(p => p.Id == pId);
            await LoadDbChatSession();
        }
    }

    private string PersonaModeKey => "po_brainstorming";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chatMessages.Any())
        {
            await ScrollToBottom();
        }
    }

    private async Task LoadDbChatSession()
    {
        if (selectedProjectId == 0) return;
        isLoadingChat = true;
        StateHasChanged();
        try
        {
            var session = await ApiClient.GetChatSessionAsync(selectedProjectId, PersonaModeKey);
            if (session != null && session.Messages.Any())
            {
                chatMessages = session.Messages;
            }
            else
            {
                chatMessages = new();
            }
        }
        finally
        {
            isLoadingChat = false;
            StateHasChanged();
            await Task.Delay(100);
            await ScrollToBottom();
        }
    }

    private async Task SaveDbChatSession()
    {
        if (selectedProjectId == 0) return;
        await ApiClient.SaveChatMessagesAsync(selectedProjectId, PersonaModeKey, chatMessages);
    }

    private void UsePrompt(string text)
    {
        userPromptInput = text;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendChatMessage();
        }
    }

    private async Task SendChatMessage(bool isClarificationPhase = false)
    {
        if (selectedProjectId == 0 || string.IsNullOrWhiteSpace(userPromptInput) || isThinking) return;

        var prompt = userPromptInput.Trim();
        userPromptInput = "";

        chatMessages.Add(new ChatMessageDto { Role = "user", Content = prompt });
        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                },
                isClarificationPhase: isClarificationPhase);
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task TriggerClarificationRound()
    {
        if (selectedProjectId == 0 || isThinking) return;

        if (!string.IsNullOrWhiteSpace(userPromptInput))
        {
            var prompt = userPromptInput.Trim();
            userPromptInput = "";
            chatMessages.Add(new ChatMessageDto { Role = "user", Content = prompt });
        }

        if (!chatMessages.Any()) return;

        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                },
                isClarificationPhase: true);
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task RetryLastQuery()
    {
        if (isThinking || selectedProjectId == 0) return;

        if (chatMessages.Any() && chatMessages.Last().Role == "assistant")
        {
            chatMessages.RemoveAt(chatMessages.Count - 1);
        }

        if (!chatMessages.Any(m => m.Role == "user")) return;

        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                });
        }
        catch (Exception ex)
        {
            assistantMsg.Content = $"[HTTP Error 500] {ex.Message}";
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('aiWorkspaceChatStream'); if(el) { el.scrollTop = el.scrollHeight; }");
        }
        catch { }
    }

    private void AddDraftCriterion()
    {
        draftCriteria.Add("");
    }

    private async Task StructureIntoSpec()
    {
        if (selectedProjectId == 0) return;

        isStructuring = true;
        StateHasChanged();

        try
        {
            var result = await ApiClient.StructureChatAsync(selectedProjectId, chatMessages);
            if (result != null)
            {
                if (!string.IsNullOrWhiteSpace(result.Title)) draftTitle = result.Title;
                if (!string.IsNullOrWhiteSpace(result.Description)) draftDesc = result.Description;
                if (result.AcceptanceCriteria.Any()) draftCriteria = result.AcceptanceCriteria;
            }

            // Publish structured requirements to Project's Single Master Specification & Log Version Snapshot!
            var publishedSpec = await ApiClient.PublishMasterSpecAsync(selectedProjectId, new CreateSpecDto
            {
                Title = draftTitle,
                Description = draftDesc,
                AcceptanceCriteria = draftCriteria.Where(c => !string.IsNullOrWhiteSpace(c)).ToList(),
                ScopeTags = new List<string> { "api", "security", "workflow" }
            });

            Nav.NavigateTo($"/specs/{selectedProjectId}");
        }
        finally
        {
            isStructuring = false;
            StateHasChanged();
        }
    }

    private async Task ClearChat()
    {
        chatMessages.Clear();
        if (selectedProjectId > 0)
        {
            await ApiClient.ClearChatSessionAsync(selectedProjectId, PersonaModeKey);
        }
    }

    public class ParsedQuestion
    {
        public int Number { get; set; }
        public string QuestionText { get; set; } = "";
        public List<string> Options { get; set; } = new();
    }

    private static List<ParsedQuestion> ParseQuestionOptions(string content)
    {
        var list = new List<ParsedQuestion>();
        if (string.IsNullOrWhiteSpace(content)) return list;

        var lines = content.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);
        ParsedQuestion? currentQuestion = null;

        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            var matchQ = System.Text.RegularExpressions.Regex.Match(trimmed, @"^(\d+)[\.\)]\s*(.+)");
            if (matchQ.Success)
            {
                if (currentQuestion != null && !string.IsNullOrWhiteSpace(currentQuestion.QuestionText))
                {
                    list.Add(currentQuestion);
                }
                currentQuestion = new ParsedQuestion
                {
                    Number = int.Parse(matchQ.Groups[1].Value),
                    QuestionText = matchQ.Groups[2].Value
                };
                continue;
            }

            var matchOpt = System.Text.RegularExpressions.Regex.Match(trimmed, @"^[-*\s]*([A-D])[\.\)]\s*(.+)");
            if (matchOpt.Success && currentQuestion != null)
            {
                var letter = matchOpt.Groups[1].Value;
                var optText = matchOpt.Groups[2].Value;
                currentQuestion.Options.Add($"{letter}) {optText}");
            }
        }

        if (currentQuestion != null && !string.IsNullOrWhiteSpace(currentQuestion.QuestionText))
        {
            list.Add(currentQuestion);
        }

        return list;
    }

    private async Task SelectOptionAnswer(int qNum, string optionText)
    {
        if (isThinking) return;
        userPromptInput = $"Q{qNum}: {optionText}";
        await SendChatMessage(false);
    }

    private void SelectManualAnswer(int qNum)
    {
        userPromptInput = $"Q{qNum}: ";
    }

    private async Task SkipQuestion(int qNum)
    {
        if (isThinking) return;
        userPromptInput = $"Q{qNum}: Not sure yet";
        await SendChatMessage(false);
    }
}
