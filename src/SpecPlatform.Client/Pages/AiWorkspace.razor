    }

    private async Task SaveManualInputAnswer(ChatMessageDto msg, int qNum)
    {
        if (string.IsNullOrWhiteSpace(manualInputText)) return;
        var val = $"Manual: {manualInputText.Trim()}";
        await SaveInlineMCQAnswer(msg, qNum, val);
    }

    private async Task SkipInlineMCQQuestion(ChatMessageDto msg, int qNum)
    {
        await SaveInlineMCQAnswer(msg, qNum, "Not sure yet");
    }

