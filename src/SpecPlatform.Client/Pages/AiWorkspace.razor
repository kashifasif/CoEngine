@page "/ai-workspace"
@page "/ai-workspace/{ProjectId:int}"
@page "/po-brainstorming"
@page "/po-brainstorming/{ProjectId:int}"
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="flex flex-col h-[calc(100vh-56px)] -m-6 sm:-m-8 bg-zinc-50 dark:bg-zinc-950">

    <!-- Top Chat Toolbar -->
    <header class="h-14 border-b border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-zinc-900/90 backdrop-blur-md px-6 flex items-center justify-between shrink-0 gap-4">
        <div class="flex items-center gap-3">
            <span class="material-symbols-outlined text-indigo-600 dark:text-indigo-400 text-xl">auto_awesome</span>
            <h2 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight m-0">AI Brainstorming Workspace</h2>
        </div>

        <div class="flex items-center gap-2.5 flex-wrap">
            <!-- Project Dropdown -->
            <select class="form-input text-xs py-1.5 w-auto" value="@selectedProjectId" @onchange="OnProjectSelected">
                @foreach (var p in projects)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>

            @if (GetUnansweredQuestions().Any())
            {
                var pendingCount = GetUnansweredQuestions().Count;
                <span class="badge badge-warning text-xs py-1 px-2.5" title="Answer or skip remaining questions to publish">
                    @pendingCount Question@(pendingCount > 1 ? "s" : "") Left
                </span>
            }

            <button class="btn-secondary text-xs py-1.5 px-3" @onclick="OpenIngestModal" title="Import transcript or notes">
                <span class="material-symbols-outlined text-[16px]">upload_file</span>
                <span>Import</span>
            </button>

            <button class="btn-secondary text-xs p-1.5" @onclick="ClearChat" title="Clear History">
                <span class="material-symbols-outlined text-[16px]">delete</span>
            </button>

            <button class="btn-primary text-xs py-1.5 px-3" @onclick="StructureIntoSpec" disabled="@(isStructuring || GetUnansweredQuestions().Any() || !HasSufficientDataToStructure())" title="@(!HasSufficientDataToStructure() ? "Please brainstorm or provide a draft description first" : GetUnansweredQuestions().Any() ? "Please answer or skip remaining questions to publish" : "Structure and publish specification")">
                @if (isStructuring)
                {
                    <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1.5"></div>
                    <span>Structuring...</span>
                }
                else
                {
                    <span class="material-symbols-outlined text-[16px]">publish</span>
                    <span>Publish Spec</span>
                }
            </button>
        </div>
    </header>

    <!-- Chat Messages Stream -->
    <div id="aiWorkspaceChatStream" class="flex-1 overflow-y-auto p-6 flex flex-col gap-6 max-w-4xl w-full mx-auto">

        @if (isLoadingChat)
        {
            <div class="py-20 flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500 font-mono text-xs">
                <div class="animate-spin w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full mb-3"></div>
                <span>Loading conversation history...</span>
            </div>
        }
        else if (!chatMessages.Any())
        {
            <div class="my-auto flex flex-col items-center justify-center text-center py-12">
                <div class="w-12 h-12 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 flex items-center justify-center mb-4">
                    <span class="material-symbols-outlined text-2xl">auto_awesome</span>
                </div>
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100 mb-2">Ready to brainstorm requirements</h3>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 max-w-md mb-6 leading-relaxed">
                    Describe your user story, security boundaries, or APIs for <strong class="text-zinc-800 dark:text-zinc-200">@(selectedProject?.Name ?? "this project")</strong>.
                </p>

                <div class="flex flex-wrap justify-center gap-2 max-w-lg">
                    <button class="btn-secondary text-xs py-1.5 px-3" @onclick='() => UsePrompt("Let us define user authentication and step-up MFA for loan approval.")'>
                        MFA Authentication Rules
                    </button>
                    <button class="btn-secondary text-xs py-1.5 px-3" @onclick='() => UsePrompt("What API rate limits and HTTP error status codes should be specified?")'>
                        Rate Limiting & Errors
                    </button>
                </div>
            </div>
        }
        else
        {
            @foreach (var msg in chatMessages)
            {
                bool isError = msg.Role == "assistant" && (msg.Content.Contains("[HTTP Error") || msg.Content.StartsWith("[Error") || msg.Content.Contains("[API Warning") || (!isThinking && string.IsNullOrWhiteSpace(msg.Content)));

                <div class="flex flex-col @(msg.Role == "user" ? "items-end" : "items-start") w-full">
                    <div class="text-[11px] font-mono font-medium text-zinc-400 dark:text-zinc-500 mb-1 px-1">
                        @(msg.Role == "user" ? "You" : "SpecAI")
                    </div>

                    @if (msg.Role == "user")
                    {
                        <div class="bg-indigo-600 text-white rounded-2xl rounded-tr-xs px-4 py-3 text-xs leading-relaxed max-w-[85%] whitespace-pre-wrap shadow-xs">
                            @msg.Content
                        </div>
                    }
                    else
                    {
                        <div class="card p-5 max-w-[90%] w-full flex flex-col gap-3 shadow-xs">
                            @if (isError)
                            {
                                <div class="flex items-center gap-3">
                                    <span class="text-rose-600 text-xs font-mono">Failed to receive response</span>
                                    <button class="btn-secondary text-xs py-1 px-2.5" @onclick="RetryLastQuery" disabled="@isThinking">
                                        <span class="material-symbols-outlined text-[14px]">refresh</span>
                                        <span>Retry</span>
                                    </button>
                                </div>
                            }
                            else
                            {
                                var parsedQuestions = ParseQuestionOptions(msg.Content);

                                @if (!parsedQuestions.Any())
                                {
                                    <div class="text-xs text-zinc-800 dark:text-zinc-200 leading-relaxed prose dark:prose-invert max-w-none">
                                        @((MarkupString)Markdig.Markdown.ToHtml(CleanAnswerTags(msg.Content)))
                                    </div>
                                }
                                else
                                {
                                    <div class="flex flex-col gap-4">
                                        @foreach (var q in parsedQuestions)
                                        {
                                            var qKey = $"{msg.Content.GetHashCode()}_{q.Number}";
                                            bool isEditingManual = activeManualInputQKey == qKey;

                                            <div class="p-4 rounded-xl border border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-950/40 flex flex-col gap-3">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="flex items-start gap-2 text-xs font-semibold text-zinc-900 dark:text-zinc-100">
                                                        <span class="badge badge-primary text-[10px] shrink-0 mt-0.5">Q@(q.Number)</span>
                                                        <span>@q.QuestionText</span>
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(q.SelectedAnswer))
                                                    {
                                                        <span class="badge badge-success text-[10px] shrink-0">Answered</span>
                                                    }
                                                </div>

                                                <div class="flex flex-col gap-2">
                                                    @foreach (var opt in q.Options)
                                                    {
                                                        bool isSelected = q.SelectedAnswer == opt;
                                                        <button class="text-left px-3.5 py-2.5 rounded-lg border text-xs font-medium transition-colors flex items-center justify-between cursor-pointer @(isSelected ? "bg-indigo-50 border-indigo-300 text-indigo-900 dark:bg-indigo-950/60 dark:border-indigo-700 dark:text-indigo-200 font-semibold" : "bg-white dark:bg-zinc-900 border-zinc-200 dark:border-zinc-800 text-zinc-700 dark:text-zinc-300 hover:border-zinc-300 dark:hover:border-zinc-700")"
                                                                @onclick="() => SaveInlineMCQAnswer(msg, q.Number, opt)"
                                                                disabled="@isThinking">
                                                            <span>@opt</span>
                                                            @if (isSelected)
                                                            {
                                                                <span class="material-symbols-outlined text-[16px] text-indigo-600 dark:text-indigo-400">check</span>
                                                            }
                                                        </button>
                                                    }
                                                </div>

                                                <!-- Quick Actions (Manual input / Skip) -->
                                                <div class="flex items-center gap-2 pt-2 border-t border-zinc-200/60 dark:border-zinc-800/60">
                                                    <button class="text-[11px] text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 font-medium cursor-pointer" @onclick="() => ToggleManualInput(qKey)">
                                                        Custom Answer
                                                    </button>
                                                    <span class="text-zinc-300 dark:text-zinc-700">&bull;</span>
                                                    <button class="text-[11px] text-amber-600 dark:text-amber-400 hover:underline cursor-pointer" @onclick="() => SkipInlineMCQQuestion(msg, q.Number)">
                                                        Skip ("Not sure yet")
                                                    </button>
                                                </div>

                                                @if (isEditingManual)
                                                {
                                                    <div class="flex gap-2 pt-2">
                                                        <input type="text" class="form-input text-xs" placeholder="Type custom answer for Q@q.Number..." @bind="manualInputText" />
                                                        <button class="btn-primary text-xs shrink-0" @onclick="() => SaveManualInputAnswer(msg, q.Number)">Save</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }

            @if (isThinking && string.IsNullOrEmpty(currentStreamingResponse))
            {
                <div class="flex items-center gap-2 text-xs text-indigo-600 dark:text-indigo-400 font-mono py-2">
                    <div class="animate-spin w-4 h-4 border-2 border-indigo-600 border-t-transparent rounded-full"></div>
                    <span>SpecAI is formulating response...</span>
                </div>
            }
        }

    </div>

    <!-- Input Bar -->
    <footer class="p-4 border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-900 shrink-0">
        <div class="max-w-4xl mx-auto flex flex-col gap-2.5">
            <div class="flex gap-2 items-end">
                <textarea id="aiWorkspaceInput" class="form-input text-xs leading-relaxed resize-none min-h-[56px] max-h-36" placeholder="Describe requirements, acceptance criteria, or ask questions..." @bind="userPromptInput" @onkeydown="HandleKeyDown" disabled="@isThinking"></textarea>
                <button class="btn-primary p-3 rounded-lg shrink-0 h-[42px] w-[42px]" @onclick="() => SendChatMessage(false)" disabled="@isThinking" title="Send (Enter)">
                    <span class="material-symbols-outlined text-[18px]">send</span>
                </button>
            </div>

            <div class="flex items-center justify-between text-[11px] text-zinc-400 dark:text-zinc-500 font-mono">
                <span>Press Enter to send</span>
                <button class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline font-medium cursor-pointer" @onclick="TriggerClarificationRound" disabled="@(isThinking || !chatMessages.Any())">
                    Start Clarification Round &rarr;
                </button>
            </div>
        </div>
    </footer>

</div>

<!-- Self-Review Panel Modal -->
@if (showSelfReviewPanel && selfReviewResult != null)
{
    <div class="fixed inset-0 bg-zinc-950/40 dark:bg-zinc-950/70 backdrop-blur-xs z-40" @onclick="CancelSelfReviewAndReset"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="card w-full max-w-2xl shadow-xl overflow-hidden flex flex-col max-h-[85vh] animate-in fade-in zoom-in-95 duration-150">
            <div class="px-5 py-4 border-b border-zinc-200 dark:border-zinc-800 flex justify-between items-center bg-zinc-50/50 dark:bg-zinc-900/50">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-indigo-600 dark:text-indigo-400 text-lg">verified_user</span>
                    <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 m-0">Specification Quality Review</h3>
                </div>
                <button class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer" @onclick="CancelSelfReviewAndReset">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>

            <div class="p-5 flex flex-col gap-4 overflow-y-auto">
                @if (selfReviewResult.AutoFixes.Any())
                {
                    <div class="p-3.5 bg-indigo-50/60 dark:bg-indigo-950/30 border border-indigo-200/80 dark:border-indigo-800/50 rounded-lg text-xs text-indigo-900 dark:text-indigo-200">
                        <strong class="block mb-1">Auto-Fixed (@selfReviewResult.AutoFixes.Count items):</strong>
                        <ul class="list-disc pl-4 space-y-0.5 font-mono text-[11px]">
                            @foreach (var fix in selfReviewResult.AutoFixes)
                            {
                                <li>@fix</li>
                            }
                        </ul>
                    </div>
                }

                <div class="flex flex-col gap-2.5">
                    @RenderCheckRow("Placeholder Scan", selfReviewResult.Checks.PlaceholderScan, "scan")
                    @RenderCheckRow("Internal Consistency", selfReviewResult.Checks.InternalConsistency, "compare_arrows")
                    @RenderCheckRow("Scope Check", selfReviewResult.Checks.ScopeCheck, "adjust")
                    @RenderCheckRow("Ambiguity Check", selfReviewResult.Checks.AmbiguityCheck, "help_center")
                </div>
            </div>

            <div class="px-5 py-3.5 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 flex justify-between items-center">
                <button class="btn-secondary text-xs" @onclick="CancelSelfReviewAndReset" disabled="@isPublishing">Cancel</button>
                <button class="btn-primary text-xs" @onclick="ConfirmPublishAfterReview" disabled="@isPublishing">
                    @if (isPublishing)
                    {
                        <span>Publishing...</span>
                    }
                    else if (selfReviewResult.Passed)
                    {
                        <span>Publish Spec</span>
                    }
                    else
                    {
                        <span>Publish Anyway</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Transcript Ingestion Modal -->
@if (showIngestModal)
{
    <div class="fixed inset-0 bg-zinc-950/40 dark:bg-zinc-950/70 backdrop-blur-xs z-40" @onclick="CloseIngestModal"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="card w-full max-w-2xl shadow-xl overflow-hidden flex flex-col max-h-[85vh] animate-in fade-in zoom-in-95 duration-150">
            <div class="px-5 py-4 border-b border-zinc-200 dark:border-zinc-800 flex justify-between items-center bg-zinc-50/50 dark:bg-zinc-900/50">
                <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 m-0">Import Raw Notes &amp; Transcripts</h3>
                <button class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer" @onclick="CloseIngestModal">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>

            <div class="p-5 flex flex-col gap-4 overflow-y-auto">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Source Type</label>
                        <select class="form-input text-xs font-mono" @bind="rawSourceTag">
                            <option value="MS Teams Meeting Transcript">MS Teams Meeting</option>
                            <option value="Zoom / Call Transcript">Zoom / Call</option>
                            <option value="Sprint Grooming Notes">Sprint Grooming</option>
                            <option value="Client Requirements Email / PRD">Client PRD / Email</option>
                            <option value="Jira / User Story Dump">Jira User Story</option>
                            <option value="Raw Written Notes">Raw Notes</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Upload File</label>
                        <InputFile OnChange="HandleTranscriptFileUpload" class="form-input text-xs" accept=".txt,.md,.vtt,.json" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Transcript Content</label>
                    <textarea class="form-input text-xs font-mono" rows="6" placeholder="Paste notes or conversation transcript here..." @bind="rawTranscriptText"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(ingestError))
                {
                    <div class="p-3 bg-rose-50 text-rose-700 text-xs rounded-lg border border-rose-200">
                        @ingestError
                    </div>
                }
            </div>

            <div class="px-5 py-3.5 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="CloseIngestModal" disabled="@isIngesting">Cancel</button>
                <button class="btn-primary text-xs" @onclick="SubmitIngestTranscript" disabled="@(isIngesting || string.IsNullOrWhiteSpace(rawTranscriptText))">
                    @if (isIngesting)
                    {
                        <span>Ingesting...</span>
                    }
                    else
                    {
                        <span>Analyze &amp; Ingest</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? ProjectId { get; set; }

    private List<ProjectDto> projects = new();
    private ProjectDto? selectedProject;
    private int selectedProjectId = 0;

    private List<ChatMessageDto> chatMessages = new();
    private string userPromptInput = "";
    private bool isThinking = false;
    private bool isLoadingChat = false;
    private string currentStreamingResponse = "";

    private bool isStructuring = false;

    private bool showSelfReviewPanel = false;
    private bool isPublishing = false;
    private SelfReviewResultDto? selfReviewResult = null;
    private StructuredSpecResultDto? pendingStructuredResult = null;

    private bool showIngestModal = false;
    private string rawTranscriptText = "";
    private string rawSourceTag = "MS Teams Meeting Transcript";
    private bool isIngesting = false;
    private string ingestError = "";

    private void OpenIngestModal()
    {
        showIngestModal = true;
        ingestError = "";
    }

    private void CloseIngestModal()
    {
        if (!isIngesting)
        {
            showIngestModal = false;
            ingestError = "";
        }
    }

    private async Task HandleTranscriptFileUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var reader = new System.IO.StreamReader(stream);
                rawTranscriptText = await reader.ReadToEndAsync();

                if (file.Name.EndsWith(".vtt", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "MS Teams Meeting Transcript (.vtt)";
                }
                else if (file.Name.Contains("teams", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "MS Teams Meeting Transcript";
                }
                else if (file.Name.Contains("zoom", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "Zoom Call Transcript";
                }
                else if (file.Name.Contains("jira", StringComparison.OrdinalIgnoreCase))
                {
                    rawSourceTag = "Jira User Story Dump";
                }

                ingestError = "";
            }
        }
        catch (Exception ex)
        {
            ingestError = $"Error reading file: {ex.Message}";
        }
    }

    private async Task SubmitIngestTranscript()
    {
        if (string.IsNullOrWhiteSpace(rawTranscriptText) || selectedProjectId == 0) return;

        isIngesting = true;
        ingestError = "";

        try
        {
            var result = await ApiClient.IngestRawTranscriptAsync(selectedProjectId, rawSourceTag, rawTranscriptText);

            if (result != null && result.Success)
            {
                chatMessages.Add(new ChatMessageDto
                {
                    Role = "user",
                    Content = $"[Uploaded Raw Transcript - {rawSourceTag}]:\n{rawTranscriptText.Substring(0, Math.Min(400, rawTranscriptText.Length))}..."
                });

                chatMessages.Add(new ChatMessageDto
                {
                    Role = "assistant",
                    Content = result.SummaryReply
                });

                showIngestModal = false;
                rawTranscriptText = "";
                await ScrollToBottom();
            }
            else
            {
                ingestError = "Failed to process transcript. Please ensure the API is running and try again.";
            }
        }
        catch (Exception ex)
        {
            ingestError = $"Error: {ex.Message}";
        }
        finally
        {
            isIngesting = false;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAuthSessionAsync()) return;
        await LoadProjects();
    }

    private async Task<bool> EnsureAuthSessionAsync()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "spec_user_session");
            if (!string.IsNullOrWhiteSpace(sessionJson))
            {
                var user = System.Text.Json.JsonSerializer.Deserialize<UserDto>(sessionJson);
                if (user != null && user.IsAuthenticated)
                {
                    ApiClient.SetAuthToken(user.Token);
                    return true;
                }
            }
        }
        catch { }

        Nav.NavigateTo("/");
        return false;
    }

    private async Task LoadProjects()
    {
        projects = await ApiClient.GetProjectsAsync();
        if (projects.Any())
        {
            if (ProjectId.HasValue && projects.Any(p => p.Id == ProjectId.Value))
            {
                selectedProjectId = ProjectId.Value;
            }
            else
            {
                selectedProjectId = projects.First().Id;
            }

            selectedProject = projects.FirstOrDefault(p => p.Id == selectedProjectId);
            await LoadDbChatSession();
        }
    }

    private async Task OnProjectSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int pId))
        {
            selectedProjectId = pId;
            selectedProject = projects.FirstOrDefault(p => p.Id == pId);
            await LoadDbChatSession();
        }
    }

    private string PersonaModeKey => "po_brainstorming";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chatMessages.Any())
        {
            await ScrollToBottom();
        }
    }

    private async Task LoadDbChatSession()
    {
        if (selectedProjectId == 0) return;
        isLoadingChat = true;
        StateHasChanged();
        try
        {
            var session = await ApiClient.GetChatSessionAsync(selectedProjectId, PersonaModeKey);
            if (session != null && session.Messages.Any())
            {
                chatMessages = session.Messages;
            }
            else
            {
                chatMessages = new();
            }
        }
        finally
        {
            isLoadingChat = false;
            StateHasChanged();
            await Task.Delay(100);
            await ScrollToBottom();
        }
    }

    private async Task SaveDbChatSession()
    {
        if (selectedProjectId == 0) return;
        await ApiClient.SaveChatMessagesAsync(selectedProjectId, PersonaModeKey, chatMessages);
    }

    private void UsePrompt(string text)
    {
        userPromptInput = text;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendChatMessage();
        }
    }

    private async Task SendChatMessage(bool isClarificationPhase = false)
    {
        if (selectedProjectId == 0 || isThinking) return;

        var domVal = await JS.InvokeAsync<string>("getChatInputValue", "aiWorkspaceInput");
        var prompt = !string.IsNullOrWhiteSpace(domVal) ? domVal.Trim() : (userPromptInput ?? "").Trim();
        if (string.IsNullOrWhiteSpace(prompt)) return;

        userPromptInput = "";
        await JS.InvokeVoidAsync("clearChatInputValue", "aiWorkspaceInput");

        chatMessages.Add(new ChatMessageDto { Role = "user", Content = prompt });
        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                },
                isClarificationPhase: isClarificationPhase);
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task TriggerClarificationRound()
    {
        if (selectedProjectId == 0 || isThinking) return;

        if (!string.IsNullOrWhiteSpace(userPromptInput))
        {
            var prompt = userPromptInput.Trim();
            userPromptInput = "";
            chatMessages.Add(new ChatMessageDto { Role = "user", Content = prompt });
        }

        if (!chatMessages.Any()) return;

        var lastAssistantMsg = chatMessages.LastOrDefault(m => m.Role == "assistant");
        if (lastAssistantMsg != null)
        {
            var questions = ParseQuestionOptions(lastAssistantMsg.Content);
            if (questions.Any())
            {
                var unanswered = questions.Where(q => string.IsNullOrEmpty(q.SelectedAnswer)).ToList();
                if (unanswered.Any())
                {
                    var qNumbers = string.Join(", ", unanswered.Select(u => $"Q{u.Number}"));
                    chatMessages.Add(new ChatMessageDto
                    {
                        Role = "assistant",
                        Content = $"ℹ️ **Pending Questions Remaining:** Please select or skip the remaining unanswered question(s) above ({qNumbers}) before requesting further clarification."
                    });
                    await SaveDbChatSession();
                    StateHasChanged();
                    await ScrollToBottom();
                    return;
                }
            }
            else if (lastAssistantMsg.Content.Contains("fully clarified") ||
                     lastAssistantMsg.Content.Contains("No clarifying questions needed") ||
                     lastAssistantMsg.Content.Contains("Fully Clarified"))
            {
                chatMessages.Add(new ChatMessageDto
                {
                    Role = "assistant",
                    Content = "✅ **Fully Clarified:** All feature requirements have already been clarified! Click **Publish Spec** when ready."
                });
                await SaveDbChatSession();
                StateHasChanged();
                await ScrollToBottom();
                return;
            }
        }

        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                },
                isClarificationPhase: true);
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task RetryLastQuery()
    {
        if (isThinking || selectedProjectId == 0) return;

        if (chatMessages.Any() && chatMessages.Last().Role == "assistant")
        {
            chatMessages.RemoveAt(chatMessages.Count - 1);
        }

        if (!chatMessages.Any(m => m.Role == "user")) return;

        var assistantMsg = new ChatMessageDto { Role = "assistant", Content = "" };
        chatMessages.Add(assistantMsg);

        isThinking = true;
        currentStreamingResponse = "";
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            await ApiClient.SendChatStreamAsync(
                selectedProjectId,
                chatMessages.Take(chatMessages.Count - 1).ToList(),
                chunk =>
                {
                    currentStreamingResponse += chunk;
                    assistantMsg.Content = currentStreamingResponse;
                    StateHasChanged();
                    _ = ScrollToBottom();
                });
        }
        catch (Exception ex)
        {
            assistantMsg.Content = $"[HTTP Error 500] {ex.Message}";
        }
        finally
        {
            isThinking = false;
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "const el = document.getElementById('aiWorkspaceChatStream'); if(el) { el.scrollTop = el.scrollHeight; }");
        }
        catch { }
    }

    private List<ParsedQuestion> GetUnansweredQuestions()
    {
        var assistantMsg = chatMessages.LastOrDefault(m => m.Role == "assistant" && ParseQuestionOptions(m.Content).Any());
        if (assistantMsg != null)
        {
            var questions = ParseQuestionOptions(assistantMsg.Content);
            return questions.Where(q => string.IsNullOrEmpty(q.SelectedAnswer)).ToList();
        }

        return new List<ParsedQuestion>();
    }

    private bool HasSufficientDataToStructure()
    {
        return chatMessages.Any(m => m.Role == "user");
    }

    private async Task StructureIntoSpec()
    {
        if (selectedProjectId == 0) return;

        if (!HasSufficientDataToStructure())
        {
            chatMessages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = "⚠️ **Cannot Publish Specification:** You have not provided any brainstorming data or draft information. Please start a conversation first."
            });
            StateHasChanged();
            await ScrollToBottom();
            return;
        }

        var unanswered = GetUnansweredQuestions();
        if (unanswered.Any())
        {
            var qNumbers = string.Join(", ", unanswered.Select(u => $"Q{u.Number}"));
            chatMessages.Add(new ChatMessageDto
            {
                Role = "assistant",
                Content = $"⚠️ **Cannot Publish Specification:** You have unanswered clarifying question(s) remaining (**{qNumbers}**). Please select an option or click **Skip (\"Not sure yet\")** before publishing."
            });
            await SaveDbChatSession();
            StateHasChanged();
            await ScrollToBottom();
            return;
        }

        isStructuring = true;
        StateHasChanged();

        try
        {
            var result = await ApiClient.StructureChatAsync(selectedProjectId, chatMessages);

            if (result == null)
            {
                chatMessages.Add(new ChatMessageDto
                {
                    Role = "assistant",
                    Content = "⚠️ **Structuring failed.** The AI did not return a valid specification. Please try again."
                });
                StateHasChanged();
                await ScrollToBottom();
                return;
            }

            pendingStructuredResult = result;
            selfReviewResult = result.SelfReviewResult;

            if (selfReviewResult != null)
            {
                isStructuring = false;
                showSelfReviewPanel = true;
                StateHasChanged();
                if (selfReviewResult.Passed && !selfReviewResult.AutoFixes.Any())
                {
                    await ConfirmPublishAfterReview();
                }
                return;
            }

            await DoPublish(result);
        }
        finally
        {
            isStructuring = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmPublishAfterReview()
    {
        if (pendingStructuredResult == null) return;
        isPublishing = true;
        StateHasChanged();
        try
        {
            await DoPublish(pendingStructuredResult);
        }
        finally
        {
            isPublishing = false;
            showSelfReviewPanel = false;
            selfReviewResult = null;
            pendingStructuredResult = null;
            StateHasChanged();
        }
    }

    private void CancelSelfReviewAndReset()
    {
        showSelfReviewPanel = false;
        selfReviewResult = null;
        pendingStructuredResult = null;
        isStructuring = false;
        isPublishing = false;
        StateHasChanged();
    }

    private async Task DoPublish(StructuredSpecResultDto result)
    {
        string finalTitle = result.Title ?? "Master Feature Specification";
        string finalDesc = result.Description ?? "Synthesized from AI brainstorming chat.";
        var finalCriteria = result.AcceptanceCriteria?.Where(c => !string.IsNullOrWhiteSpace(c)).ToList() ?? new List<string>();

        string? selfReviewJson = null;
        if (selfReviewResult != null)
        {
            try { selfReviewJson = System.Text.Json.JsonSerializer.Serialize(selfReviewResult); }
            catch { }
        }

        await ApiClient.PublishMasterSpecAsync(selectedProjectId, new CreateSpecDto
        {
            Title = finalTitle,
            Description = finalDesc,
            AcceptanceCriteria = finalCriteria,
            ScopeTags = result.ScopeTags?.Any() == true ? result.ScopeTags : new List<string> { "bff", "api", "mfe" },
            SelfReviewJson = selfReviewJson
        });

        Nav.NavigateTo($"/specs/{selectedProjectId}");
    }

    private int CountSelfReviewIssues()
    {
        if (selfReviewResult == null) return 0;
        return (selfReviewResult.Checks.PlaceholderScan.Issues?.Count ?? 0)
             + (selfReviewResult.Checks.InternalConsistency.Issues?.Count ?? 0)
             + (selfReviewResult.Checks.ScopeCheck.Issues?.Count ?? 0)
             + (selfReviewResult.Checks.AmbiguityCheck.Issues?.Count ?? 0);
    }

    private RenderFragment RenderCheckRow(string label, SelfReviewCheckDto check, string icon) => __builder =>
    {
        <div class="p-3.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-950/40 flex flex-col gap-2">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs font-semibold text-zinc-900 dark:text-zinc-100">
                    <span class="material-symbols-outlined text-[16px] text-zinc-400">@icon</span>
                    <span>@label</span>
                </div>
                @if (check.Passed)
                {
                    <span class="badge badge-success text-[10px]">Passed</span>
                }
                else
                {
                    <span class="badge badge-danger text-[10px]">Issues Found</span>
                }
            </div>
            @if (!check.Passed && check.Issues?.Any() == true)
            {
                <ul class="list-disc pl-4 space-y-0.5 text-[11px] text-zinc-600 dark:text-zinc-400 font-mono">
                    @foreach (var issue in check.Issues)
                    {
                        <li>@issue</li>
                    }
                </ul>
            }
        </div>
    };

    private async Task ClearChat()
    {
        chatMessages.Clear();
        if (selectedProjectId > 0)
        {
            await ApiClient.ClearChatSessionAsync(selectedProjectId, PersonaModeKey);
        }
    }

    private static string CleanAnswerTags(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        return System.Text.RegularExpressions.Regex.Replace(content, @"\s*<!-- MCQ_ANSWER_\d+: .*? -->", "").Trim();
    }

    public class ParsedQuestion
    {
        public int Number { get; set; }
        public string QuestionText { get; set; } = "";
        public List<string> Options { get; set; } = new();
        public string SelectedAnswer { get; set; } = "";
    }

    private static List<ParsedQuestion> ParseQuestionOptions(string content)
    {
        var list = new List<ParsedQuestion>();
        if (string.IsNullOrWhiteSpace(content)) return list;

        try
        {
            var displayContent = CleanAnswerTags(content);
            var lines = displayContent.Split(new[] { "\r\n", "\r", "\n" }, StringSplitOptions.RemoveEmptyEntries);
            ParsedQuestion? currentQuestion = null;

            foreach (var line in lines)
            {
                var trimmed = line.Trim();

                var matchOpt = System.Text.RegularExpressions.Regex.Match(trimmed, @"^[-*\s]*([A-D])[\.\)]\s*(.+)");
                if (matchOpt.Success && currentQuestion != null)
                {
                    var letter = matchOpt.Groups[1].Value;
                    var optText = matchOpt.Groups[2].Value.Trim('*', '_', ' ');
                    currentQuestion.Options.Add($"{letter}) {optText}");
                    continue;
                }

                var matchQ = System.Text.RegularExpressions.Regex.Match(trimmed, @"^(?:[-*\s])*?[*_]*(?:Q|Question\s*)?(\d+)[\.\):]*[*_]*\s*(.+)");
                if (matchQ.Success)
                {
                    var qNumStr = matchQ.Groups[1].Value;
                    var qTextClean = matchQ.Groups[2].Value.Trim('*', '_', ' ', ':');

                    if (!string.IsNullOrWhiteSpace(qTextClean))
                    {
                        if (currentQuestion != null && !string.IsNullOrWhiteSpace(currentQuestion.QuestionText))
                        {
                            list.Add(currentQuestion);
                        }

                        int qNum = int.TryParse(qNumStr, out var n) ? n : (list.Count + 1);

                        currentQuestion = new ParsedQuestion
                        {
                            Number = qNum,
                            QuestionText = qTextClean
                        };

                        var matchAns = System.Text.RegularExpressions.Regex.Match(content, $@"<!-- MCQ_ANSWER_{qNum}: (.*?) -->");
                        if (matchAns.Success)
                        {
                            currentQuestion.SelectedAnswer = matchAns.Groups[1].Value.Trim();
                        }

                        continue;
                    }
                }
            }

            if (currentQuestion != null && !string.IsNullOrWhiteSpace(currentQuestion.QuestionText))
            {
                list.Add(currentQuestion);
            }

            for (int i = 0; i < list.Count; i++)
            {
                if (list[i].Number <= 0)
                {
                    list[i].Number = i + 1;
                }
            }
        }
        catch { }

        return list;
    }

    private string activeManualInputQKey = "";
    private string manualInputText = "";

    private void ToggleManualInput(string qKey)
    {
        if (activeManualInputQKey == qKey)
        {
            activeManualInputQKey = "";
        }
        else
        {
            activeManualInputQKey = qKey;
            manualInputText = "";
        }
    }

    private async Task SaveInlineMCQAnswer(ChatMessageDto msg, int qNum, string answerValue)
    {
        if (isThinking) return;

        var pattern = $@"<!-- MCQ_ANSWER_{qNum}: .*? -->";
        msg.Content = System.Text.RegularExpressions.Regex.Replace(msg.Content, pattern, "");
        msg.Content = msg.Content.Trim() + $"\n<!-- MCQ_ANSWER_{qNum}: {answerValue} -->";

        activeManualInputQKey = "";
        await SaveDbChatSession();
        StateHasChanged();
    }

    private async Task SaveManualInputAnswer(ChatMessageDto msg, int qNum)
    {
        if (string.IsNullOrWhiteSpace(manualInputText)) return;
        var val = $"Manual: {manualInputText.Trim()}";
        await SaveInlineMCQAnswer(msg, qNum, val);
    }

    private async Task SkipInlineMCQQuestion(ChatMessageDto msg, int qNum)
    {
        await SaveInlineMCQAnswer(msg, qNum, "Not sure yet");
    }
}
