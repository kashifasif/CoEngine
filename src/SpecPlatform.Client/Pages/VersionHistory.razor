@page "/versions"
@page "/versions/{SpecId:int}"
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="w-full flex flex-col gap-6">

    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 pb-6 border-b border-zinc-200 dark:border-zinc-800">
        <div>
            <div class="flex items-center gap-1.5 text-xs text-zinc-400 dark:text-zinc-500 font-mono mb-1.5">
                <a href="specs" class="hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors no-underline">Specifications</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-zinc-700 dark:text-zinc-300 font-medium">Version History</span>
            </div>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Specification Versions &amp; Undo/Redo</h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Manage published releases, rollback with Undo/Redo, and compare diffs.</p>
        </div>

        @if (specs.Any())
        {
            <div class="flex items-center gap-1.5 p-1 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-lg overflow-x-auto max-w-full">
                @foreach (var s in specs)
                {
                    var isSelected = s.Id == selectedSpecId;
                    <button class="px-3 py-1.5 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer @(isSelected ? "bg-white dark:bg-zinc-800 text-indigo-600 dark:text-indigo-400 shadow-sm border border-zinc-200/80 dark:border-zinc-700 font-semibold" : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 hover:bg-zinc-200/50 dark:hover:bg-zinc-800/50")" @onclick="() => SelectSpecById(s.Id)">
                        <span class="material-symbols-outlined text-[15px] @(isSelected ? "text-indigo-600 dark:text-indigo-400" : "text-zinc-400")">description</span>
                        <span>@s.Title</span>
                        <span class="badge badge-default text-[10px] py-0 px-1.5">v@(s.CurrentVersionNumber)</span>
                    </button>
                }
            </div>
        }
    </div>

    @if (selectedSpec != null)
    {
        <!-- Version Timeline Log & Undo/Redo Controls (ALWAYS VISIBLE) -->
        <div class="card p-6 flex flex-col gap-4">
            <div class="flex items-center justify-between pb-3 border-b border-zinc-100 dark:border-zinc-800">
                <div>
                    <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 m-0">Published Releases &amp; Lifecycle</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Click <strong>Undo</strong> to rollback a published version or <strong>Redo</strong> to restore it in the pgvector embedding store.</p>
                </div>
                <span class="badge badge-primary text-xs">@selectedSpec.Versions.Count Version@(selectedSpec.Versions.Count == 1 ? "" : "s")</span>
            </div>

            @if (!selectedSpec.Versions.Any())
            {
                <div class="py-8 text-center text-zinc-400 dark:text-zinc-500 text-xs font-mono">
                    No published versions found for this specification.
                </div>
            }
            else
            {
                <div class="divide-y divide-zinc-100 dark:divide-zinc-800/80">
                    @foreach (var ver in selectedSpec.Versions.OrderByDescending(v => v.VersionNumber))
                    {
                        var isUndone = ver.IsUndone;
                        <div class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 @(isUndone ? "opacity-60 bg-zinc-50/50 dark:bg-zinc-950/30 -mx-6 px-6" : "") transition-all">
                            <div class="flex items-center gap-3">
                                <span class="badge @(isUndone ? "badge-default" : "badge-primary") text-xs font-semibold">
                                    v@(ver.VersionNumber)
                                </span>
                                <div>
                                    <div class="text-xs font-medium text-zinc-900 dark:text-zinc-100 @(isUndone ? "line-through text-zinc-400 dark:text-zinc-500" : "")">
                                        @(string.IsNullOrWhiteSpace(ver.Content) ? $"Version {ver.VersionNumber} Snapshot" : ver.Content)
                                    </div>
                                    <div class="text-[11px] text-zinc-400 dark:text-zinc-500 font-mono mt-0.5">
                                        @ver.AcceptanceCriteria.Count criteria &bull; @ver.ScopeTags.Count tags &bull; @ver.PublishedAt.ToLocalTime().ToString("g")
                                    </div>
                                </div>
                                @if (isUndone)
                                {
                                    <span class="badge badge-danger text-[10px]">Undone (Archived)</span>
                                }
                            </div>

                            <!-- Action Buttons: Download .md / Undo / Redo -->
                            <div class="flex items-center gap-2 shrink-0">
                                <button class="btn-secondary text-xs py-1.5 px-3 cursor-pointer" @onclick="() => DownloadVersionMarkdownAsync(ver)" title="Download version .md file">
                                    <span class="material-symbols-outlined text-[16px] text-emerald-600 dark:text-emerald-400">download</span>
                                    <span>Download .md</span>
                                </button>
                                @if (isUndone)
                                {
                                    <button class="btn-primary text-xs py-1.5 px-3 bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-600 dark:hover:bg-emerald-500 cursor-pointer" @onclick="() => PromptRedoVersion(ver.VersionNumber)" disabled="@isTogglingStatus" title="Restore this version into active search index">
                                        <span class="material-symbols-outlined text-[16px]">redo</span>
                                        <span>Redo Version</span>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-secondary text-xs py-1.5 px-3 text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 border-rose-200 dark:border-rose-900/60 cursor-pointer" @onclick="() => PromptUndoVersion(ver.VersionNumber)" disabled="@isTogglingStatus" title="Undo / Rollback this published specification release">
                                        <span class="material-symbols-outlined text-[16px]">undo</span>
                                        <span>Undo Version</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Version Comparison / Diff Section -->
        @if (selectedSpec.Versions.Count >= 2)
        {
            <div class="card p-5 flex flex-col gap-4">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 m-0">Compare Version Diff</h3>
                        <span class="text-xs text-zinc-400 dark:text-zinc-500">Inspect acceptance criteria added or removed between two releases.</span>
                    </div>

                    <!-- Version Selectors -->
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-xs text-zinc-400 font-mono">From:</span>
                        <div class="flex items-center gap-1 p-0.5 bg-zinc-100 dark:bg-zinc-900 rounded-md border border-zinc-200 dark:border-zinc-800">
                            @foreach (var v in selectedSpec.Versions.OrderBy(v => v.VersionNumber))
                            {
                                var isSel = v1 == v.VersionNumber;
                                <button class="px-2 py-0.5 text-xs font-mono rounded transition-all cursor-pointer @(isSel ? "bg-indigo-600 text-white font-bold" : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200")" @onclick="() => v1 = v.VersionNumber">
                                    v@(v.VersionNumber)
                                </button>
                            }
                        </div>

                        <span class="text-zinc-400 font-mono text-xs px-1">&rarr;</span>

                        <span class="text-xs text-zinc-400 font-mono">To:</span>
                        <div class="flex items-center gap-1 p-0.5 bg-zinc-100 dark:bg-zinc-900 rounded-md border border-zinc-200 dark:border-zinc-800">
                            @foreach (var v in selectedSpec.Versions.OrderBy(v => v.VersionNumber))
                            {
                                var isSel = v2 == v.VersionNumber;
                                <button class="px-2 py-0.5 text-xs font-mono rounded transition-all cursor-pointer @(isSel ? "bg-indigo-600 text-white font-bold" : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200")" @onclick="() => v2 = v.VersionNumber">
                                    v@(v.VersionNumber)
                                </button>
                            }
                        </div>

                        <button class="btn-primary text-xs" @onclick="CompareVersions" disabled="@(v1 == v2 || isLoadingDiff)">
                            <span class="material-symbols-outlined text-[16px]">compare_arrows</span>
                            <span>Compare</span>
                        </button>
                    </div>
                </div>

                <!-- Diff Results -->
                @if (isLoadingDiff)
                {
                    <div class="py-12 flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500 font-mono text-xs">
                        <div class="animate-spin w-5 h-5 border-2 border-indigo-600 border-t-transparent rounded-full mb-2"></div>
                        <span>Calculating differences between v@(v1) and v@(v2)...</span>
                    </div>
                }
                else if (diffResult != null)
                {
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        <!-- Added Criteria -->
                        <div class="card p-4 border-emerald-200 dark:border-emerald-900/60 bg-emerald-50/30 dark:bg-emerald-950/20 flex flex-col gap-2.5">
                            <span class="text-xs font-semibold text-emerald-700 dark:text-emerald-300 flex items-center gap-1.5 pb-2 border-b border-emerald-200/60 dark:border-emerald-900/40">
                                <span class="material-symbols-outlined text-[16px]">add_circle</span>
                                <span>Added Criteria (+@diffResult.AddedCriteria.Count)</span>
                            </span>

                            @if (!diffResult.AddedCriteria.Any())
                            {
                                <span class="text-xs text-zinc-400 italic py-1">No criteria added.</span>
                            }
                            else
                            {
                                <ul class="space-y-1 list-none p-0 m-0 text-xs">
                                    @foreach (var item in diffResult.AddedCriteria)
                                    {
                                        <li class="text-emerald-900 dark:text-emerald-200 flex items-start gap-1.5 leading-relaxed">
                                            <span class="text-emerald-600 font-bold shrink-0">+</span>
                                            <span>@item</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        <!-- Removed Criteria -->
                        <div class="card p-4 border-rose-200 dark:border-rose-900/60 bg-rose-50/30 dark:bg-rose-950/20 flex flex-col gap-2.5">
                            <span class="text-xs font-semibold text-rose-700 dark:text-rose-300 flex items-center gap-1.5 pb-2 border-b border-rose-200/60 dark:border-rose-900/40">
                                <span class="material-symbols-outlined text-[16px]">remove_circle</span>
                                <span>Removed Criteria (-@diffResult.RemovedCriteria.Count)</span>
                            </span>

                            @if (!diffResult.RemovedCriteria.Any())
                            {
                                <span class="text-xs text-zinc-400 italic py-1">No criteria removed.</span>
                            }
                            else
                            {
                                <ul class="space-y-1 list-none p-0 m-0 text-xs">
                                    @foreach (var item in diffResult.RemovedCriteria)
                                    {
                                        <li class="text-rose-900 dark:text-rose-200 flex items-start gap-1.5 leading-relaxed opacity-80">
                                            <span class="text-rose-600 font-bold shrink-0">-</span>
                                            <span class="line-through">@item</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }

</div>

<!-- Undo Version Modal Dialog -->
@if (undoVersionTarget.HasValue)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => undoVersionTarget = null"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-amber-200 dark:border-amber-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">undo</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Undo Specification Release (v@(undoVersionTarget.Value))</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        Are you sure you want to rollback Version <strong>@(undoVersionTarget.Value)</strong>? It will be marked as undone/archived and excluded from AI queries. You can restore it at any time.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => undoVersionTarget = null" disabled="@isTogglingStatus">Cancel</button>
                <button class="btn-primary text-xs bg-amber-600 hover:bg-amber-700 dark:bg-amber-600 dark:hover:bg-amber-500 border-none flex items-center gap-1.5" @onclick="ExecuteUndoVersion" disabled="@isTogglingStatus">
                    @if (isTogglingStatus)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Undoing...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">undo</span>
                        <span>Confirm Undo</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Redo Version Modal Dialog -->
@if (redoVersionTarget.HasValue)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => redoVersionTarget = null"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-emerald-200 dark:border-emerald-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">redo</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Redo & Restore Release (v@(redoVersionTarget.Value))</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        This will restore Version <strong>@(redoVersionTarget.Value)</strong> back into active status and re-index all its criteria into the PostgreSQL vector store.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => redoVersionTarget = null" disabled="@isTogglingStatus">Cancel</button>
                <button class="btn-primary text-xs bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-600 dark:hover:bg-emerald-500 border-none flex items-center gap-1.5" @onclick="ExecuteRedoVersion" disabled="@isTogglingStatus">
                    @if (isTogglingStatus)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Restoring...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">redo</span>
                        <span>Confirm Redo</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int? SpecId { get; set; }

    private List<SpecDto> specs = new();
    private SpecDto? selectedSpec;
    private int selectedSpecId = 0;
    private int v1 = 1;
    private int v2 = 1;

    private SpecDiffDto? diffResult;
    private bool isLoadingDiff = false;
    private bool isTogglingStatus = false;

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAuthSessionAsync()) return;
        await LoadSpecs();
    }

    private async Task<bool> EnsureAuthSessionAsync()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "spec_user_session");
            if (!string.IsNullOrWhiteSpace(sessionJson))
            {
                var user = System.Text.Json.JsonSerializer.Deserialize<UserDto>(sessionJson);
                if (user != null && user.IsAuthenticated)
                {
                    ApiClient.SetAuthToken(user.Token);
                    return true;
                }
            }
        }
        catch { }

        Nav.NavigateTo("/");
        return false;
    }

    private async Task LoadSpecs()
    {
        var projects = await ApiClient.GetProjectsAsync();
        if (projects.Any())
        {
            var pSpecs = await ApiClient.GetSpecsForProjectAsync(projects.First().Id);
            if (pSpecs.Any())
            {
                specs = pSpecs;
                selectedSpecId = SpecId.HasValue && specs.Any(s => s.Id == SpecId.Value) ? SpecId.Value : specs.First().Id;
                await SelectSpec(selectedSpecId);
            }
        }
    }

    private async Task SelectSpecById(int specId)
    {
        if (selectedSpecId == specId) return;
        await SelectSpec(specId);
    }

    private async Task OnSpecSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int sId))
        {
            await SelectSpec(sId);
        }
    }

    private async Task SelectSpec(int specId)
    {
        selectedSpecId = specId;
        selectedSpec = specs.FirstOrDefault(s => s.Id == specId);
        if (selectedSpec != null && selectedSpec.Versions.Count >= 2)
        {
            var vers = selectedSpec.Versions.OrderBy(v => v.VersionNumber).ToList();
            v1 = vers.First().VersionNumber;
            v2 = vers.Last().VersionNumber;
            await CompareVersions();
        }
        else
        {
            diffResult = null;
        }
    }

    private async Task CompareVersions()
    {
        if (selectedSpecId == 0 || v1 == 0 || v2 == 0) return;
        isLoadingDiff = true;
        StateHasChanged();
        try
        {
            diffResult = await ApiClient.CompareVersionsAsync(selectedSpecId, v1, v2);
        }
        finally
        {
            isLoadingDiff = false;
            StateHasChanged();
        }
    }

    private int? undoVersionTarget;
    private int? redoVersionTarget;

    private void PromptUndoVersion(int versionNumber)
    {
        undoVersionTarget = versionNumber;
    }

    private async Task ExecuteUndoVersion()
    {
        if (selectedSpecId == 0 || !undoVersionTarget.HasValue) return;
        isTogglingStatus = true;
        try
        {
            var updatedSpec = await ApiClient.UndoPublishSpecAsync(selectedSpecId, undoVersionTarget.Value);
            if (updatedSpec != null)
            {
                var index = specs.FindIndex(s => s.Id == selectedSpecId);
                if (index != -1) specs[index] = updatedSpec;
                selectedSpec = updatedSpec;
            }
            undoVersionTarget = null;
        }
        finally
        {
            isTogglingStatus = false;
            StateHasChanged();
        }
    }

    private void PromptRedoVersion(int versionNumber)
    {
        redoVersionTarget = versionNumber;
    }

    private async Task ExecuteRedoVersion()
    {
        if (selectedSpecId == 0 || !redoVersionTarget.HasValue) return;
        isTogglingStatus = true;
        try
        {
            var updatedSpec = await ApiClient.RedoPublishSpecAsync(selectedSpecId, redoVersionTarget.Value);
            if (updatedSpec != null)
            {
                var index = specs.FindIndex(s => s.Id == selectedSpecId);
                if (index != -1) specs[index] = updatedSpec;
                selectedSpec = updatedSpec;
            }
            redoVersionTarget = null;
        }
        finally
        {
            isTogglingStatus = false;
            StateHasChanged();
        }
    }

    private async Task DownloadVersionMarkdownAsync(SpecVersionDto ver)
    {
        if (selectedSpec == null || ver == null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# {selectedSpec.Title} (v{ver.VersionNumber})");
        sb.AppendLine();
        sb.AppendLine($"**Project:** {selectedSpec.ProjectName}  ");
        sb.AppendLine($"**Status:** {(ver.IsUndone ? "Archived / Undone" : "Published")}  ");
        sb.AppendLine($"**Version:** v{ver.VersionNumber}  ");
        sb.AppendLine($"**Published At:** {ver.PublishedAt:yyyy-MM-dd HH:mm:ss} UTC  ");
        if (!string.IsNullOrWhiteSpace(ver.AuthorDisplayName) || !string.IsNullOrWhiteSpace(ver.AuthorUsername))
        {
            sb.AppendLine($"**Published By:** {ver.AuthorDisplayName ?? ver.AuthorUsername}  ");
        }
        sb.AppendLine();
        sb.AppendLine("## Description");
        sb.AppendLine();
        sb.AppendLine(ver.Content);
        sb.AppendLine();

        if (ver.AcceptanceCriteria.Any())
        {
            sb.AppendLine("## Acceptance Criteria");
            sb.AppendLine();
            foreach (var ac in ver.AcceptanceCriteria)
            {
                sb.AppendLine($"- [ ] {ac}");
            }
            sb.AppendLine();
        }

        if (ver.ScopeTags.Any())
        {
            sb.AppendLine("## Scope Tags");
            sb.AppendLine();
            sb.AppendLine(string.Join(" ", ver.ScopeTags.Select(t => $"`{t}`")));
            sb.AppendLine();
        }

        var safeTitle = string.Concat(selectedSpec.Title.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
        var fileName = $"{safeTitle}_v{ver.VersionNumber}.md";
        await JS.InvokeVoidAsync("downloadFileFromText", fileName, sb.ToString(), "text/markdown");
    }
}
