@page "/"
@page "/login"
@layout EmptyLayout
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="d-flex flex-column align-items-center justify-content-center min-vh-100 bg-surface-dim p-4">
    <div class="card bg-surface-container border border-outline-variant p-5 rounded-4 shadow-lg text-center" style="max-width: 520px; width: 100%;">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary-container p-3 mx-auto mb-4" style="width: 64px; height: 64px;">
            <span class="material-symbols-outlined text-on-primary-container" style="font-size: 32px;">security</span>
        </div>

        <h2 class="fw-bold text-on-surface mb-2 font-ui">SpecPlatform SSO</h2>
        <p class="text-on-surface-variant font-mono small mb-4">
            Protected Workspace & Enterprise Specification Management System. Please authenticate to continue.
        </p>

        <div class="bg-surface-container-high border border-outline-variant p-3 rounded-3 mb-4 text-start font-mono fs-xs text-on-surface-variant">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-success fs-sm">check_circle</span>
                <span>Role-Based Spec Access Control</span>
            </div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="material-symbols-outlined text-success fs-sm">check_circle</span>
                <span>AI Brainstorming & Q&A Audit Logs</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="material-symbols-outlined text-success fs-sm">check_circle</span>
                <span>Single Sign-On (GitHub OAuth 2.0)</span>
            </div>
        </div>

        <button class="btn btn-dark btn-lg w-100 d-flex align-items-center justify-content-center gap-3 font-mono py-3 border border-outline-variant hover-primary shadow-sm" @onclick="InitiateGitHubLogin">
            <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span>Sign In with GitHub</span>
        </button>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "spec_user_session");
            if (!string.IsNullOrWhiteSpace(sessionJson))
            {
                var user = System.Text.Json.JsonSerializer.Deserialize<UserDto>(sessionJson);
                if (user != null && user.IsAuthenticated)
                {
                    ApiClient.SetAuthToken(user.Token);
                    Nav.NavigateTo("/dashboard");
                }
            }
        }
        catch { }
    }

    private async Task InitiateGitHubLogin()
    {
        try
        {
            var authUrlDto = await ApiClient.GetGitHubAuthUrlAsync();

            if (authUrlDto != null && !string.IsNullOrWhiteSpace(authUrlDto.AuthUrl))
            {
                Nav.NavigateTo(authUrlDto.AuthUrl, forceLoad: true);
            }
        }
        catch { }
    }
}
