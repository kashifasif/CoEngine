@page "/"
@page "/login"
@layout EmptyLayout
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="min-h-screen bg-zinc-50 dark:bg-zinc-950 flex flex-col items-center justify-center p-6">
    <div class="card p-8 sm:p-10 w-full max-w-md shadow-lg flex flex-col items-center text-center animate-in fade-in zoom-in-95 duration-150">
        <!-- Logo Badge -->
        <div class="w-12 h-12 rounded-xl bg-indigo-600 flex items-center justify-center text-white shadow-xs mb-6">
            <span class="material-symbols-outlined text-2xl">layers</span>
        </div>

        <h1 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mb-1.5">Welcome to SpecPlatform</h1>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-6 leading-relaxed">
            Enterprise specification engine with AI synthesis and vector grounding.
        </p>

        <!-- Feature List -->
        <div class="w-full bg-zinc-50 dark:bg-zinc-950/60 border border-zinc-200/80 dark:border-zinc-800 rounded-lg p-4 mb-6 text-left space-y-2.5">
            <div class="flex items-center gap-2.5 text-xs text-zinc-700 dark:text-zinc-300">
                <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-base shrink-0">check_circle</span>
                <span>AI Brainstorming &amp; Auto Self-Review</span>
            </div>
            <div class="flex items-center gap-2.5 text-xs text-zinc-700 dark:text-zinc-300">
                <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-base shrink-0">check_circle</span>
                <span>PostgreSQL PgVector Grounded Q&amp;A</span>
            </div>
            <div class="flex items-center gap-2.5 text-xs text-zinc-700 dark:text-zinc-300">
                <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-base shrink-0">check_circle</span>
                <span>Version Timeline with Undo &amp; Diff</span>
            </div>
        </div>

        <!-- GitHub Sign-In Button -->
        <button class="w-full bg-zinc-900 hover:bg-zinc-800 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-100 text-white font-medium text-xs py-3 px-4 rounded-lg flex items-center justify-center gap-2.5 transition-colors shadow-xs cursor-pointer" @onclick="InitiateGitHubLogin">
            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span>Sign In with GitHub</span>
        </button>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "spec_user_session");
            if (!string.IsNullOrWhiteSpace(sessionJson))
            {
                var user = System.Text.Json.JsonSerializer.Deserialize<UserDto>(sessionJson);
                if (user != null && user.IsAuthenticated)
                {
                    ApiClient.SetAuthToken(user.Token);
                    Nav.NavigateTo("/dashboard");
                }
            }
        }
        catch { }
    }

    private async Task InitiateGitHubLogin()
    {
        try
        {
            var authUrlDto = await ApiClient.GetGitHubAuthUrlAsync();

            if (authUrlDto != null && !string.IsNullOrWhiteSpace(authUrlDto.AuthUrl))
            {
                Nav.NavigateTo(authUrlDto.AuthUrl, forceLoad: true);
            }
        }
        catch { }
    }
}
