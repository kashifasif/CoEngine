@page "/specs"
@page "/specs/{ProjectId:guid}"
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="w-full flex flex-col gap-6">

    <!-- Header & Project Selector -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-zinc-200 dark:border-zinc-800">
        <div>
            <!-- Breadcrumbs -->
            <div class="flex items-center gap-1.5 text-xs text-zinc-400 dark:text-zinc-500 font-mono mb-1.5">
                <a href="dashboard" class="hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors no-underline">Projects</a>
                <span class="material-symbols-outlined text-[14px]">chevron_right</span>
                <span class="text-zinc-700 dark:text-zinc-300 font-medium">@(selectedProject?.Name ?? "Select Project")</span>
            </div>

            <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">Project Specification</h1>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Master technical specification and live contract.</p>
        </div>

        <!-- Action Controls -->
        <div class="flex flex-wrap items-center gap-2.5">
            <!-- Project Selection Tabs -->
            @if (projects.Any())
            {
                <div class="flex items-center gap-1.5 p-1 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200/80 dark:border-zinc-800 rounded-lg overflow-x-auto max-w-full">
                    @foreach (var proj in projects)
                    {
                        var isSelected = proj.Id == selectedProjectId;
                        <button class="px-3 py-1.5 rounded-md text-xs font-medium transition-all flex items-center gap-1.5 whitespace-nowrap cursor-pointer @(isSelected ? "bg-white dark:bg-zinc-800 text-indigo-600 dark:text-indigo-400 shadow-sm border border-zinc-200/80 dark:border-zinc-700 font-semibold" : "text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-200 hover:bg-zinc-200/50 dark:hover:bg-zinc-800/50")" @onclick="() => SelectProjectById(proj.Id)">
                            <span class="material-symbols-outlined text-[15px] @(isSelected ? "text-indigo-600 dark:text-indigo-400" : "text-zinc-400")">folder</span>
                            <span>@proj.Name</span>
                        </button>
                    }
                </div>
            }

            <button class="btn-secondary text-xs" @onclick="OpenAiWorkspace" title="Brainstorm and refine in AI Workspace">
                <span class="material-symbols-outlined text-[16px] text-indigo-600 dark:text-indigo-400">auto_awesome</span>
                <span>AI Workspace</span>
            </button>

            @if (masterSpec != null)
            {
                <button class="btn-secondary text-xs" @onclick="OpenVersionHistory" title="View Version Diff History & Manage Releases">
                    <span class="material-symbols-outlined text-[16px]">history</span>
                    <span>Version History &amp; Undo/Redo (v@(masterSpec.CurrentVersionNumber))</span>
                </button>

                <button class="btn-secondary text-xs cursor-pointer" @onclick="DownloadMarkdownAsync" title="Download Markdown (.md) File">
                    <span class="material-symbols-outlined text-[16px] text-emerald-600 dark:text-emerald-400">download</span>
                    <span>Download .md</span>
                </button>

                <button class="btn-primary text-xs" @onclick="ExportPdfAsync" title="Export PDF Specification">
                    <span class="material-symbols-outlined text-[16px]">picture_as_pdf</span>
                    <span>Export PDF</span>
                </button>
            }
        </div>
    </div>

    <!-- Notification Banner -->
    @if (!string.IsNullOrEmpty(notificationAlert))
    {
        <div class="card p-3.5 border-emerald-200 dark:border-emerald-800/80 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-100 flex items-center justify-between animate-in fade-in duration-150">
            <div class="flex items-center gap-2.5">
                <span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-lg">check_circle</span>
                <span class="text-xs font-mono">
                    <strong>Publish Release:</strong> @notificationAlert
                </span>
            </div>
            <button class="text-emerald-600 dark:text-emerald-400 hover:text-emerald-900 dark:hover:text-emerald-200 p-1 cursor-pointer" @onclick="() => notificationAlert = null">
                <span class="material-symbols-outlined text-[16px]">close</span>
            </button>
        </div>
    }

    <!-- Content Area -->
    @if (selectedProject != null)
    {
        if (isLoadingSpecs)
        {
            <div class="py-20 flex flex-col items-center justify-center text-zinc-400 dark:text-zinc-500 font-mono text-xs">
                <div class="animate-spin w-6 h-6 border-2 border-indigo-600 border-t-transparent rounded-full mb-3"></div>
                <span>Loading specification for @selectedProject.Name...</span>
            </div>
        }
        else if (masterSpec == null)
        {
            <div class="card p-12 text-center border-dashed border-zinc-300 dark:border-zinc-800 flex flex-col items-center justify-center gap-4">
                <div class="w-12 h-12 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-400 dark:text-zinc-500 flex items-center justify-center">
                    <span class="material-symbols-outlined text-2xl">description</span>
                </div>
                <div class="max-w-md">
                    <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 mb-1">No master specification published yet</h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-relaxed">
                        Use the AI Brainstorming Workspace to draft and clarify requirements. Once published, your synthesized master specification will appear here.
                    </p>
                </div>
                <button class="btn-primary text-xs" @onclick="OpenAiWorkspace">
                    <span class="material-symbols-outlined text-[16px]">auto_awesome</span>
                    <span>Start Brainstorming in AI Workspace</span>
                </button>
            </div>
        }
        else
        {
            <div class="card p-6 flex flex-col gap-6">
                <!-- Specification Title & Header Meta -->
                <div class="flex flex-col md:flex-row md:items-start justify-between pb-5 border-b border-zinc-100 dark:border-zinc-800/80 gap-4">
                    <div>
                        <div class="flex items-center gap-2 mb-2 flex-wrap">
                            <span class="badge badge-default">SPEC-00@(masterSpec.Id)</span>
                            <span class="@(masterSpec.Status == "Published" ? "badge-success" : "badge-warning")">
                                @masterSpec.Status
                            </span>
                            <span class="badge badge-primary">Version @(masterSpec.CurrentVersionNumber)</span>

                            @if (!string.IsNullOrEmpty(masterSpec.CreatedByDisplayName) || !string.IsNullOrEmpty(masterSpec.CreatedByUsername))
                            {
                                <span class="badge badge-default flex items-center gap-1 text-[11px]" title="Created by @(masterSpec.CreatedByDisplayName ?? masterSpec.CreatedByUsername)">
                                    @if (!string.IsNullOrEmpty(masterSpec.CreatedByAvatarUrl))
                                    {
                                        <img src="@masterSpec.CreatedByAvatarUrl" class="w-3.5 h-3.5 rounded-full object-cover border border-zinc-300 dark:border-zinc-700" />
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined text-[13px]">person</span>
                                    }
                                    <span>Created by @(masterSpec.CreatedByDisplayName ?? masterSpec.CreatedByUsername)</span>
                                </span>
                            }

                            <!-- Direct Quick Undo / Redo Actions -->
                            @if (masterSpec.Versions.Any())
                            {
                                var latestVersion = masterSpec.Versions.OrderByDescending(v => v.VersionNumber).FirstOrDefault();
                                if (latestVersion != null)
                                {
                                    if (latestVersion.IsUndone)
                                    {
                                        <button class="badge badge-success cursor-pointer hover:opacity-80 transition-opacity flex items-center gap-1" @onclick="() => PromptRedoVersion(latestVersion.VersionNumber)" disabled="@isTogglingStatus" title="Restore this undone version">
                                            <span class="material-symbols-outlined text-[12px]">redo</span>
                                            <span>Redo v@(latestVersion.VersionNumber)</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="badge badge-danger cursor-pointer hover:opacity-80 transition-opacity flex items-center gap-1" @onclick="() => PromptUndoVersion(latestVersion.VersionNumber)" disabled="@isTogglingStatus" title="Undo / Rollback this published version">
                                            <span class="material-symbols-outlined text-[12px]">undo</span>
                                            <span>Undo Release</span>
                                        </button>
                                    }
                                }
                            }
                        </div>
                        <h2 class="text-xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">@masterSpec.Title</h2>
                    </div>

                    <div class="flex items-center gap-2">
                        <button class="btn-secondary text-xs" @onclick="OpenVersionHistory" title="View Version History and Rollbacks">
                            <span class="material-symbols-outlined text-[16px]">history</span>
                            <span>Versions (@masterSpec.Versions.Count)</span>
                        </button>
                        <button class="btn-secondary text-xs p-2 text-rose-600 hover:text-rose-700 hover:bg-rose-50 dark:hover:bg-rose-950/30" @onclick="() => ConfirmDeleteSpec(masterSpec)" title="Delete Specification">
                            <span class="material-symbols-outlined text-[16px]">delete</span>
                        </button>
                    </div>
                </div>

                <!-- Master Description -->
                <div>
                    <h4 class="text-[11px] uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500 mb-2">Description & Scope</h4>
                    <div class="p-4 bg-zinc-50 dark:bg-zinc-950/50 border border-zinc-200/80 dark:border-zinc-800 rounded-lg text-zinc-800 dark:text-zinc-200 text-xs leading-relaxed prose dark:prose-invert max-w-none">
                        @((MarkupString)Markdig.Markdown.ToHtml(masterSpec.Description ?? ""))
                    </div>
                </div>

                <!-- Scope Tags -->
                @if (masterSpec.CurrentScopeTags.Any())
                {
                    <div>
                        <h4 class="text-[11px] uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500 mb-2">Scope Tags</h4>
                        <div class="flex gap-2 flex-wrap">
                            @foreach (var tag in masterSpec.CurrentScopeTags)
                            {
                                <span class="badge badge-default text-xs py-1 px-2.5">
                                    @GetTagIcon(tag) @tag
                                </span>
                            }
                        </div>
                    </div>
                }

                <!-- Functional & Acceptance Criteria -->
                <div>
                    <h4 class="text-[11px] uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500 mb-3">
                        Functional & Acceptance Criteria (@masterSpec.CurrentAcceptanceCriteria.Count)
                    </h4>

                    @if (!masterSpec.CurrentAcceptanceCriteria.Any())
                    {
                        <div class="text-xs text-zinc-400 dark:text-zinc-500 font-mono py-2">No criteria defined.</div>
                    }
                    else
                    {
                        <div class="flex flex-col gap-2.5">
                            @for (int i = 0; i < masterSpec.CurrentAcceptanceCriteria.Count; i++)
                            {
                                var criterion = masterSpec.CurrentAcceptanceCriteria[i];
                                @if (criterion.StartsWith("👤") || criterion.StartsWith("📋") || criterion.StartsWith("###"))
                                {
                                    <div class="p-3 bg-indigo-50/60 dark:bg-indigo-950/30 border border-indigo-200/80 dark:border-indigo-800/50 rounded-lg text-indigo-900 dark:text-indigo-200 font-semibold text-xs mt-2">
                                        @criterion
                                    </div>
                                }
                                else if (criterion.StartsWith("❓"))
                                {
                                    <div class="p-3 bg-amber-50/60 dark:bg-amber-950/30 border border-amber-200/80 dark:border-amber-800/50 rounded-lg text-amber-900 dark:text-amber-200 text-xs flex items-start gap-2.5">
                                        <span class="material-symbols-outlined text-amber-600 dark:text-amber-400 text-base shrink-0 mt-0.5">help_outline</span>
                                        <div class="leading-relaxed">@criterion</div>
                                    </div>
                                }
                                else
                                {
                                    <div class="p-3 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-lg flex items-start gap-3 hover:border-zinc-300 dark:hover:border-zinc-700 transition-colors">
                                        <span class="badge badge-success text-[10px] shrink-0 mt-0.5">
                                            @(criterion.StartsWith("AC-") ? criterion.Split(':')[0] : $"AC-{(i + 1)}")
                                        </span>
                                        <div class="text-zinc-800 dark:text-zinc-200 text-xs leading-relaxed">
                                            @(criterion.StartsWith("AC-") && criterion.Contains(":") ? criterion.Substring(criterion.IndexOf(':') + 1).Trim() : criterion)
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }

</div>

<!-- Create / Edit Spec Modal -->
@if (showSpecModal)
{
    <div class="fixed inset-0 bg-zinc-950/40 dark:bg-zinc-950/70 backdrop-blur-xs z-40" @onclick="() => showSpecModal = false"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4">
        <div class="card w-full max-w-2xl shadow-xl overflow-hidden flex flex-col max-h-[85vh] animate-in fade-in zoom-in-95 duration-150">
            <div class="px-5 py-4 border-b border-zinc-200 dark:border-zinc-800 flex justify-between items-center bg-zinc-50/50 dark:bg-zinc-900/50 shrink-0">
                <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 m-0">Create Specification Draft</h3>
                <button class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer" @onclick="() => showSpecModal = false">
                    <span class="material-symbols-outlined text-[18px]">close</span>
                </button>
            </div>

            <div class="p-5 flex flex-col gap-4 overflow-y-auto">
                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Title</label>
                    <input type="text" class="form-input text-xs" placeholder="e.g. Customer Portal & KYC Pipeline" @bind="specFormTitle"/>
                </div>
                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Description</label>
                    <textarea class="form-input text-xs" rows="4" placeholder="Overview of business goals and user personas..." @bind="specFormDesc"></textarea>
                </div>

                <!-- Acceptance Criteria Rows -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="text-xs font-medium text-zinc-700 dark:text-zinc-300">Acceptance Criteria</label>
                        <button class="text-xs text-indigo-600 dark:text-indigo-400 hover:underline cursor-pointer font-medium" @onclick="AddCriterionRow">+ Add Row</button>
                    </div>
                    <div class="flex flex-col gap-2">
                        @for (int i = 0; i < specFormCriteria.Count; i++)
                        {
                            var idx = i;
                            <div class="flex items-center gap-2">
                                <span class="text-zinc-400 text-xs font-mono w-6 text-center">#@(idx + 1)</span>
                                <input type="text" class="form-input text-xs" placeholder="Criteria definition..." @bind="specFormCriteria[idx]"/>
                                <button class="text-zinc-400 hover:text-rose-600 p-1 cursor-pointer" @onclick="() => specFormCriteria.RemoveAt(idx)">
                                    <span class="material-symbols-outlined text-[16px]">delete</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Scope Tags (Comma-separated)</label>
                    <input type="text" class="form-input text-xs font-mono" placeholder="api, auth, sec-rule, bff" @bind="specFormTagsRaw"/>
                </div>
            </div>

            <div class="px-5 py-3.5 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 flex justify-end gap-2 shrink-0">
                <button class="btn-secondary text-xs" @onclick="() => showSpecModal = false">Cancel</button>
                <button class="btn-primary text-xs" @onclick="SaveSpecForm" disabled="@string.IsNullOrWhiteSpace(specFormTitle)">Save Draft</button>
            </div>
        </div>
    </div>
}

<!-- Delete Spec Modal -->
@if (specToDelete != null)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => specToDelete = null"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-rose-200 dark:border-rose-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-rose-100 dark:bg-rose-950/60 text-rose-600 dark:text-rose-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">delete_forever</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Delete Specification</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        Are you sure you want to permanently delete <strong class="text-zinc-900 dark:text-zinc-100">@specToDelete.Title</strong>? All published versions and vector index entries will be removed.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => specToDelete = null" disabled="@isDeletingSpec">Cancel</button>
                <button class="btn-danger text-xs flex items-center gap-1.5" @onclick="ExecuteDeleteSpec" disabled="@isDeletingSpec">
                    @if (isDeletingSpec)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Deleting...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">delete</span>
                        <span>Delete Specification</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Undo Version Modal -->
@if (undoVersionTarget.HasValue)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => undoVersionTarget = null"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-amber-200 dark:border-amber-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-amber-100 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">undo</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Undo Specification Release (v@(undoVersionTarget.Value))</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        This will mark Version <strong>@(undoVersionTarget.Value)</strong> as undone/archived and remove its acceptance criteria from active AI search indexing. You can redo and restore it anytime.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => undoVersionTarget = null" disabled="@isTogglingStatus">Cancel</button>
                <button class="btn-primary text-xs bg-amber-600 hover:bg-amber-700 dark:bg-amber-600 dark:hover:bg-amber-500 border-none flex items-center gap-1.5" @onclick="ExecuteUndoVersion" disabled="@isTogglingStatus">
                    @if (isTogglingStatus)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Undoing...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">undo</span>
                        <span>Confirm Undo</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Redo Version Modal -->
@if (redoVersionTarget.HasValue)
{
    <div class="fixed inset-0 bg-zinc-950/50 dark:bg-zinc-950/70 backdrop-blur-xs z-50 transition-opacity animate-in fade-in duration-100" @onclick="() => redoVersionTarget = null"></div>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
        <div class="card w-full max-w-md shadow-2xl overflow-hidden pointer-events-auto flex flex-col animate-in fade-in zoom-in-95 duration-150 border-emerald-200 dark:border-emerald-900/60 bg-white dark:bg-zinc-900">
            <div class="p-5 flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-600 dark:text-emerald-400 flex items-center justify-center shrink-0">
                    <span class="material-symbols-outlined text-[22px]">redo</span>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="text-sm font-bold text-zinc-900 dark:text-zinc-100 m-0">Redo & Restore Release (v@(redoVersionTarget.Value))</h3>
                    <p class="text-xs text-zinc-600 dark:text-zinc-400 mt-1 leading-relaxed">
                        This will reactivate Version <strong>@(redoVersionTarget.Value)</strong> and restore all its criteria for developer queries.
                    </p>
                </div>
            </div>
            <div class="px-5 py-3.5 border-t border-zinc-100 dark:border-zinc-800 bg-zinc-50/60 dark:bg-zinc-950/40 flex justify-end gap-2">
                <button class="btn-secondary text-xs" @onclick="() => redoVersionTarget = null" disabled="@isTogglingStatus">Cancel</button>
                <button class="btn-primary text-xs bg-emerald-600 hover:bg-emerald-700 dark:bg-emerald-600 dark:hover:bg-emerald-500 border-none flex items-center gap-1.5" @onclick="ExecuteRedoVersion" disabled="@isTogglingStatus">
                    @if (isTogglingStatus)
                    {
                        <div class="animate-spin w-3.5 h-3.5 border-2 border-white border-t-transparent rounded-full mr-1"></div>
                        <span>Restoring...</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[16px]">redo</span>
                        <span>Confirm Redo</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? ProjectId { get; set; }

    private List<ProjectDto> projects = new();
    private ProjectDto? selectedProject;
    private Guid selectedProjectId = Guid.Empty;
    private List<SpecDto> specs = new();

    private bool isLoadingSpecs = false;
    private bool isPublishing = false;
    private bool isTogglingStatus = false;
    private string? notificationAlert;

    private bool showSpecModal = false;
    private string specFormTitle = "";
    private string specFormDesc = "";
    private List<string> specFormCriteria = new();
    private string specFormTagsRaw = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await EnsureAuthSessionAsync()) return;
        await LoadProjects();
    }

    private async Task<bool> EnsureAuthSessionAsync()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "spec_user_session");
            if (!string.IsNullOrWhiteSpace(sessionJson))
            {
                var user = System.Text.Json.JsonSerializer.Deserialize<UserDto>(sessionJson);
                if (user != null && user.IsAuthenticated)
                {
                    ApiClient.SetAuthToken(user.Token);
                    return true;
                }
            }
        }
        catch
        {
        }

        Nav.NavigateTo("/");
        return false;
    }

    private async Task LoadProjects()
    {
        try
        {
            projects = await ApiClient.GetProjectsAsync();
            if (projects.Any())
            {
                if (ProjectId.HasValue && projects.Any(p => p.Id == ProjectId.Value))
                {
                    selectedProjectId = ProjectId.Value;
                }
                else
                {
                    selectedProjectId = projects.First().Id;
                }

                selectedProject = projects.FirstOrDefault(p => p.Id == selectedProjectId);
                await LoadSpecs();
            }
        }
        catch
        {
        }
    }

    private async Task SelectProjectById(Guid id)
    {
        if (selectedProjectId == id) return;
        selectedProjectId = id;
        await LoadSpecs();
    }

    private async Task OnProjectSelected(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out Guid pId))
        {
            selectedProjectId = pId;
            selectedProject = projects.FirstOrDefault(p => p.Id == pId);
            await LoadSpecs();
        }
    }

    private async Task LoadSpecs()
    {
        if (selectedProjectId == Guid.Empty) return;
        isLoadingSpecs = true;
        try
        {
            specs = await ApiClient.GetSpecsForProjectAsync(selectedProjectId);
        }
        finally
        {
            isLoadingSpecs = false;
        }
    }

    private SpecDto? masterSpec => specs.FirstOrDefault();

    private void OpenAiWorkspace()
    {
        Nav.NavigateTo($"/ai-workspace/{selectedProjectId}");
    }

    private void OpenVersionHistory()
    {
        if (masterSpec != null)
        {
            Nav.NavigateTo($"/versions/{masterSpec.Id}");
        }
        else
        {
            Nav.NavigateTo("/versions");
        }
    }

    private void OpenSpecEditor(Guid specId)
    {
        Nav.NavigateTo($"/spec-editor/{specId}");
    }

    private void OpenCreateSpecModal()
    {
        specFormTitle = "";
        specFormDesc = "";
        specFormCriteria = new List<string> { "" };
        specFormTagsRaw = "api, bff";
        showSpecModal = true;
    }

    private void AddCriterionRow()
    {
        specFormCriteria.Add("");
    }

    private async Task SaveSpecForm()
    {
        if (selectedProjectId == Guid.Empty || string.IsNullOrWhiteSpace(specFormTitle)) return;

        var tags = specFormTagsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(t => t.Trim())
            .Where(t => !string.IsNullOrWhiteSpace(t))
            .ToList();

        var criteria = specFormCriteria.Where(c => !string.IsNullOrWhiteSpace(c)).Select(c => c.Trim()).ToList();

        await ApiClient.CreateSpecAsync(selectedProjectId, new CreateSpecDto
        {
            Title = specFormTitle.Trim(),
            Description = specFormDesc.Trim(),
            AcceptanceCriteria = criteria,
            ScopeTags = tags
        });

        showSpecModal = false;
        await LoadSpecs();
    }

    private SpecDto? specToDelete;
    private bool isDeletingSpec = false;
    private int? undoVersionTarget;
    private int? redoVersionTarget;

    private void PromptUndoVersion(int versionNumber)
    {
        undoVersionTarget = versionNumber;
    }

    private async Task ExecuteUndoVersion()
    {
        if (masterSpec == null || !undoVersionTarget.HasValue || isTogglingStatus) return;
        isTogglingStatus = true;
        try
        {
            await ApiClient.UndoPublishSpecAsync(masterSpec.Id, undoVersionTarget.Value);
            undoVersionTarget = null;
            await LoadSpecs();
        }
        finally
        {
            isTogglingStatus = false;
        }
    }

    private void PromptRedoVersion(int versionNumber)
    {
        redoVersionTarget = versionNumber;
    }

    private async Task ExecuteRedoVersion()
    {
        if (masterSpec == null || !redoVersionTarget.HasValue || isTogglingStatus) return;
        isTogglingStatus = true;
        try
        {
            await ApiClient.RedoPublishSpecAsync(masterSpec.Id, redoVersionTarget.Value);
            redoVersionTarget = null;
            await LoadSpecs();
        }
        finally
        {
            isTogglingStatus = false;
        }
    }

    private static string GetTagIcon(string tag)
    {
        var lower = tag.ToLowerInvariant();
        if (lower.Contains("api")) return "⚙️";
        if (lower.Contains("mfe")) return "🎨";
        if (lower.Contains("auth")) return "🔒";
        if (lower.Contains("bus") || lower.Contains("event")) return "🔗";
        return "🏷️";
    }

    private void ConfirmDeleteSpec(SpecDto spec)
    {
        specToDelete = spec;
    }

    private async Task ExecuteDeleteSpec()
    {
        if (specToDelete == null || isDeletingSpec) return;
        isDeletingSpec = true;
        try
        {
            await ApiClient.DeleteSpecAsync(specToDelete.Id);
            specToDelete = null;
            await LoadSpecs();
        }
        finally
        {
            isDeletingSpec = false;
        }
    }

    private async Task ExportPdfAsync()
    {
        if (masterSpec == null || selectedProject == null) return;

        var payload = new
        {
            id = masterSpec.Id,
            projectName = selectedProject.Name,
            title = masterSpec.Title,
            description = masterSpec.Description,
            version = masterSpec.CurrentVersionNumber,
            status = masterSpec.Status,
            criteria = masterSpec.CurrentAcceptanceCriteria,
            tags = masterSpec.CurrentScopeTags,
            exportDate = DateTime.Now.ToString("dd MMM yyyy HH:mm")
        };

        await JS.InvokeVoidAsync("exportSpecToPdf", payload);
    }

    private async Task DownloadMarkdownAsync()
    {
        if (masterSpec == null || selectedProject == null) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"# {masterSpec.Title}");
        sb.AppendLine();
        sb.AppendLine($"**Project:** {selectedProject.Name}  ");
        sb.AppendLine($"**Status:** {masterSpec.Status}  ");
        sb.AppendLine($"**Version:** v{masterSpec.CurrentVersionNumber}  ");
        sb.AppendLine($"**Date:** {masterSpec.CreatedAt:yyyy-MM-dd HH:mm:ss} UTC  ");
        sb.AppendLine();
        sb.AppendLine("## Description");
        sb.AppendLine();
        sb.AppendLine(masterSpec.Description);
        sb.AppendLine();

        if (masterSpec.CurrentAcceptanceCriteria.Any())
        {
            sb.AppendLine("## Acceptance Criteria");
            sb.AppendLine();
            foreach (var ac in masterSpec.CurrentAcceptanceCriteria)
            {
                sb.AppendLine($"- [ ] {ac}");
            }
            sb.AppendLine();
        }

        if (masterSpec.CurrentScopeTags.Any())
        {
            sb.AppendLine("## Scope Tags");
            sb.AppendLine();
            sb.AppendLine(string.Join(" ", masterSpec.CurrentScopeTags.Select(t => $"`{t}`")));
            sb.AppendLine();
        }

        var safeTitle = string.Concat(masterSpec.Title.Split(System.IO.Path.GetInvalidFileNameChars())).Replace(" ", "_");
        var fileName = $"{safeTitle}_v{masterSpec.CurrentVersionNumber}.md";
        await JS.InvokeVoidAsync("downloadFileFromText", fileName, sb.ToString(), "text/markdown");
    }

}
