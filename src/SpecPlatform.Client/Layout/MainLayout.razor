@inherits LayoutComponentBase
@inject SpecApiClient ApiClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="min-h-screen flex flex-col bg-zinc-50 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 transition-colors">

    @if (currentUser != null && currentUser.IsAuthenticated)
    {
        <!-- Top Navigation Bar -->
        <header class="fixed top-0 inset-x-0 h-14 z-30 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-md border-b border-zinc-200/80 dark:border-zinc-800/80 px-4 sm:px-6 flex items-center justify-between transition-colors">
            <div class="flex items-center gap-6">
                <a class="flex items-center gap-2.5 text-zinc-900 dark:text-white no-underline font-semibold tracking-tight text-base" href="dashboard">
                    <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-xs">
                        <span class="material-symbols-outlined text-[18px]">layers</span>
                    </div>
                    <span>SpecPlatform</span>
                </a>
            </div>

            <div class="flex items-center gap-3">
                <!-- Search Bar -->
                <div class="hidden md:flex items-center bg-zinc-100 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 rounded-lg px-3 py-1.5 focus-within:border-indigo-500 focus-within:ring-1 focus-within:ring-indigo-500 transition-all">
                    <span class="material-symbols-outlined text-zinc-400 dark:text-zinc-500 text-base mr-2">search</span>
                    <input type="text" class="bg-transparent border-none text-zinc-900 dark:text-zinc-100 text-xs placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none w-44" placeholder="Search specs, APIs..." />
                    <kbd class="text-[10px] font-mono bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-zinc-400 dark:text-zinc-400 px-1.5 py-0.5 rounded shadow-2xs ml-2">⌘K</kbd>
                </div>

                <!-- Notifications -->
                <button class="relative p-2 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors" @onclick="ToggleNotificationsDrawer" title="Notifications">
                    <span class="material-symbols-outlined text-[20px]">notifications</span>
                    @if (notifications.Any())
                    {
                        <span class="absolute top-1.5 right-1.5 w-2 h-2 bg-indigo-600 rounded-full"></span>
                    }
                </button>

                <!-- Theme Toggle -->
                <button class="p-2 text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors" @onclick="ToggleTheme" title="Toggle Light/Dark Theme">
                    @if (currentTheme == "light")
                    {
                        <span class="material-symbols-outlined text-[20px]">dark_mode</span>
                    }
                    else
                    {
                        <span class="material-symbols-outlined text-[20px]">light_mode</span>
                    }
                </button>

                <!-- User Dropdown -->
                <div class="relative ml-1 pl-3 border-l border-zinc-200 dark:border-zinc-800">
                    <button class="flex items-center gap-2 focus:outline-none cursor-pointer" @onclick="ToggleUserMenu" title="@currentUser.DisplayName (@currentUser.Username)">
                        @if (!string.IsNullOrWhiteSpace(currentUser.AvatarUrl))
                        {
                            <img src="@currentUser.AvatarUrl" class="w-8 h-8 rounded-full border border-zinc-200 dark:border-zinc-700 object-cover" alt="Avatar" />
                        }
                        else
                        {
                            <div class="w-8 h-8 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-mono font-medium text-xs flex items-center justify-center border border-indigo-200 dark:border-indigo-800">
                                @(currentUser.Username.Length >= 2 ? currentUser.Username.Substring(0, 2).ToUpper() : "GH")
                            </div>
                        }
                    </button>

                    @if (showUserMenu)
                    {
                        <div class="absolute top-full right-0 mt-2 w-56 bg-white dark:bg-zinc-900 rounded-xl border border-zinc-200 dark:border-zinc-800 shadow-lg p-1.5 z-50 animate-in fade-in zoom-in-95 duration-100">
                            <div class="px-3 py-2 border-b border-zinc-100 dark:border-zinc-800/80 mb-1">
                                <div class="font-medium text-sm text-zinc-900 dark:text-zinc-100 truncate">@currentUser.DisplayName</div>
                                <div class="text-xs text-zinc-400 dark:text-zinc-500 font-mono truncate">@currentUser.Username</div>
                            </div>
                            <button class="w-full text-left px-3 py-2 text-xs font-medium text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30 rounded-lg flex items-center gap-2 transition-colors cursor-pointer" @onclick="LogoutUser">
                                <span class="material-symbols-outlined text-[16px]">logout</span>
                                <span>Sign Out</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </header>
    }

    <div class="flex flex-1 @(currentUser != null && currentUser.IsAuthenticated ? "pt-14" : "")">
        @if (currentUser != null && currentUser.IsAuthenticated)
        {
            <!-- Sidebar -->
            <aside class="fixed left-0 top-14 bottom-0 w-64 bg-white dark:bg-zinc-900 border-r border-zinc-200 dark:border-zinc-800 p-4 flex flex-col justify-between z-20 transition-colors">
                <div class="flex flex-col gap-5">
                    <!-- Project Selector / Space Badge -->
                    <div class="flex items-center gap-3 p-2.5 rounded-lg bg-zinc-50 dark:bg-zinc-800/50 border border-zinc-200/80 dark:border-zinc-800">
                        <div class="w-8 h-8 rounded-md bg-indigo-600 text-white font-mono text-xs font-semibold flex items-center justify-center shrink-0">
                            @(selectedProjectName.Length >= 2 ? selectedProjectName.Substring(0, 2).ToUpper() : "SP")
                        </div>
                        <div class="min-w-0">
                            <div class="text-[11px] uppercase tracking-wider font-semibold text-zinc-400 dark:text-zinc-500">Project Space</div>
                            <div class="text-xs font-medium text-zinc-900 dark:text-zinc-100 truncate">@selectedProjectName</div>
                        </div>
                    </div>

                    <!-- Main Navigation Links -->
                    <nav class="flex flex-col gap-1">
                        <NavLink class="flex items-center gap-3 px-3 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/50 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400" href="dashboard" Match="NavLinkMatch.All">
                            <span class="material-symbols-outlined text-[18px]">dashboard</span>
                            <span>Dashboard</span>
                        </NavLink>

                        <NavLink class="flex items-center gap-3 px-3 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/50 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400" href="specs">
                            <span class="material-symbols-outlined text-[18px]">description</span>
                            <span>Specifications</span>
                        </NavLink>

                        <NavLink class="flex items-center gap-3 px-3 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/50 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400" href="ai-workspace">
                            <span class="material-symbols-outlined text-[18px]">auto_awesome</span>
                            <span>AI Workspace</span>
                        </NavLink>

                        <NavLink class="flex items-center gap-3 px-3 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/50 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400" href="published-specs-qa">
                            <span class="material-symbols-outlined text-[18px]">chat</span>
                            <span>Published Specs Q&A</span>
                        </NavLink>

                        <NavLink class="flex items-center gap-3 px-3 py-2 text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-lg no-underline transition-colors [&.active]:bg-indigo-50 dark:[&.active]:bg-indigo-950/50 [&.active]:text-indigo-600 dark:[&.active]:text-indigo-400" href="versions">
                            <span class="material-symbols-outlined text-[18px]">history</span>
                            <span>Version History</span>
                        </NavLink>
                    </nav>
                </div>

                <!-- Footer / Secondary Links -->
                <div class="pt-4 border-t border-zinc-200 dark:border-zinc-800 flex flex-col gap-0.5 text-zinc-500 dark:text-zinc-400 text-xs">
                    <button class="flex items-center gap-2 px-2.5 py-1.5 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors w-full text-left cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">help_outline</span>
                        <span>Documentation</span>
                    </button>
                    <button class="flex items-center gap-2 px-2.5 py-1.5 rounded-md hover:bg-zinc-100 dark:hover:bg-zinc-800 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors w-full text-left cursor-pointer">
                        <span class="material-symbols-outlined text-[16px]">support</span>
                        <span>Support</span>
                    </button>
                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 ml-64 min-h-[calc(100vh-56px)] bg-zinc-50 dark:bg-zinc-950 p-6 sm:p-8 transition-colors">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="card p-4 border-rose-200 dark:border-rose-900/60 bg-rose-50 dark:bg-rose-950/30 text-rose-900 dark:text-rose-100 flex items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                <span class="material-symbols-outlined text-rose-600 dark:text-rose-400 text-xl">error_outline</span>
                                <div>
                                    <div class="font-medium text-xs">An unexpected error occurred.</div>
                                    <div class="text-[11px] text-rose-600 dark:text-rose-400 font-mono">Please refresh the page to reload the state.</div>
                                </div>
                            </div>
                            <button class="btn-danger text-xs px-3 py-1.5" onclick="location.reload()">Reload</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        }
        else
        {
            <!-- Unauthenticated View -->
            <main class="flex-1 w-full min-h-screen bg-zinc-50 dark:bg-zinc-950 flex items-center justify-center p-4">
                <ErrorBoundary>
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent Context="ex">
                        <div class="card p-4 border-rose-200 dark:border-rose-900 bg-rose-50 text-rose-900">
                            <div class="font-medium text-sm">An error occurred.</div>
                            <button class="btn-danger text-xs mt-2" onclick="location.reload()">Reload</button>
                        </div>
                    </ErrorContent>
                </ErrorBoundary>
            </main>
        }
    </div>

    <!-- Notification Drawer / Modal -->
    @if (showNotificationsDrawer)
    {
        <div class="fixed inset-0 bg-zinc-950/40 dark:bg-zinc-950/70 backdrop-blur-xs z-40 transition-opacity" @onclick="() => showNotificationsDrawer = false"></div>
        <div class="fixed inset-0 z-50 flex items-center justify-center p-4 pointer-events-none">
            <div class="card w-full max-w-lg shadow-xl overflow-hidden pointer-events-auto flex flex-col max-h-[80vh] animate-in fade-in zoom-in-95 duration-150">
                <div class="px-5 py-4 border-b border-zinc-200 dark:border-zinc-800 flex justify-between items-center bg-zinc-50/50 dark:bg-zinc-900/50">
                    <div class="flex items-center gap-2">
                        <span class="material-symbols-outlined text-indigo-600 dark:text-indigo-400 text-lg">notifications</span>
                        <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100 m-0">Release Audit Feed</h3>
                    </div>
                    <button class="text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-200 cursor-pointer" @onclick="() => showNotificationsDrawer = false">
                        <span class="material-symbols-outlined text-[18px]">close</span>
                    </button>
                </div>

                <div class="overflow-y-auto p-4 flex-1 divide-y divide-zinc-100 dark:divide-zinc-800/60">
                    @if (!notifications.Any())
                    {
                        <div class="py-12 text-center text-zinc-400 dark:text-zinc-500 text-xs font-mono">
                            No published release logs found.
                        </div>
                    }
                    else
                    {
                        @foreach (var notif in notifications)
                        {
                            <div class="py-3 first:pt-0 last:pb-0">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="badge badge-primary text-[10px]">@notif.ProjectName &bull; v@(notif.VersionNumber)</span>
                                    <span class="text-zinc-400 text-[10px] font-mono">@notif.CreatedAt.ToLocalTime().ToString("g")</span>
                                </div>
                                <div class="font-medium text-xs text-zinc-900 dark:text-zinc-100">@notif.SpecTitle</div>
                                <div class="text-zinc-500 dark:text-zinc-400 text-xs mt-0.5 line-clamp-2">@notif.SummaryText</div>
                            </div>
                        }
                    }
                </div>

                <div class="px-5 py-3 border-t border-zinc-200 dark:border-zinc-800 bg-zinc-50/50 dark:bg-zinc-900/50 flex justify-end">
                    <button class="btn-secondary text-xs px-3 py-1.5" @onclick="() => showNotificationsDrawer = false">Close</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private HealthCheckResponse? healthResponse;
    private string currentTheme = "dark";
    private bool showNotificationsDrawer = false;
    private List<NotificationDto> notifications = new();
    private string selectedProjectName = "Loan Approval Feature";
    private UserDto? currentUser;
    private bool showUserMenu = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserSession();
        EnforceAuthRedirect();

        if (currentUser != null && currentUser.IsAuthenticated)
        {
            await CheckHealth();
            await LoadNotifications();
            await LoadProjectSpace();
        }
    }

    protected override void OnParametersSet()
    {
        EnforceAuthRedirect();
    }

    private void EnforceAuthRedirect()
    {
        var relativeUri = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        if (currentUser == null || !currentUser.IsAuthenticated)
        {
            if (!string.IsNullOrWhiteSpace(relativeUri) && relativeUri != "login" && !relativeUri.StartsWith("auth/github/callback"))
            {
                Nav.NavigateTo("/");
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                currentTheme = await JS.InvokeAsync<string>("themeManager.getTheme");
                StateHasChanged();
            }
            catch
            {
            }
        }
    }

    private async Task LoadUserSession()
    {
        try
        {
            var sessionJson = await JS.InvokeAsync<string>("localStorage.getItem", "spec_user_session");
            if (!string.IsNullOrWhiteSpace(sessionJson))
            {
                currentUser = System.Text.Json.JsonSerializer.Deserialize<UserDto>(sessionJson);
            }
        }
        catch
        {
        }

        if (currentUser == null)
        {
            try
            {
                currentUser = await ApiClient.GetCurrentUserAsync();
            }
            catch
            {
            }
        }

        if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.Token))
        {
            ApiClient.SetAuthToken(currentUser.Token);
        }
    }

    private async Task InitiateGitHubLogin()
    {
        try
        {
            var authUrlDto = await ApiClient.GetGitHubAuthUrlAsync();

            if (authUrlDto != null && !string.IsNullOrWhiteSpace(authUrlDto.AuthUrl))
            {
                Nav.NavigateTo(authUrlDto.AuthUrl, forceLoad: true);
            }
        }
        catch
        {
        }
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private async Task LogoutUser()
    {
        showUserMenu = false;
        try
        {
            await ApiClient.LogoutAsync();
            await JS.InvokeVoidAsync("localStorage.removeItem", "spec_user_session");
        }
        catch
        {
        }

        currentUser = null;
        ApiClient.SetAuthToken(null);
        StateHasChanged();
        Nav.NavigateTo("/login");
    }

    private async Task LoadProjectSpace()
    {
        try
        {
            var projects = await ApiClient.GetProjectsAsync();
            if (projects.Any())
            {
                selectedProjectName = projects.First().Name;
            }
        }
        catch
        {
        }
    }

    private async Task ToggleTheme()
    {
        currentTheme = currentTheme == "light" ? "dark" : "light";
        await JS.InvokeVoidAsync("themeManager.setTheme", currentTheme);
        StateHasChanged();
    }

    private async Task CheckHealth()
    {
        try
        {
            healthResponse = await ApiClient.GetHealthAsync();
        }
        catch
        {
            healthResponse = null;
        }
    }

    private async Task ToggleNotificationsDrawer()
    {
        showNotificationsDrawer = !showNotificationsDrawer;
        if (showNotificationsDrawer)
        {
            await LoadNotifications();
        }
    }

    private async Task LoadNotifications()
    {
        try
        {
            notifications = await ApiClient.GetNotificationsAsync();
        }
        catch
        {
        }
    }

    private void TriggerNewSpec()
    {
        Nav.NavigateTo("/specs");
    }
}
