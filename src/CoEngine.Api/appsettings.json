{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "PostgresConnection": "#{POSTGRES_CONNECTION_STRING}#"
  },

  "GitHub": {
    "ClientId": "#{GITHUB_CLIENT_ID}#",
    "ClientSecret": "#{GITHUB_CLIENT_SECRET}#",
    "AppBaseUrl": "#{APP_BASE_URL}#",
    "CallbackPath": "/auth/github/callback"
  }
}
